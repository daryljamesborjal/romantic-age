---
// Full-screen photographic reading room with theme-aware light and subtle dust.
interface Props {
	backgroundImage?: string;
}

const { backgroundImage = "/images/library-room.jpg" } = Astro.props;
---

<div class="reading-room" style={`--room-background-image: url("${backgroundImage}")`}>
	<!-- The photograph, contrast overlay, and dust are purely decorative. -->
	<div class="room-backdrop" aria-hidden="true">
		<div class="room-dust"></div>
	</div>
	<div class="room-night-overlay" aria-hidden="true"></div>
	<div class="room-night-vignette" aria-hidden="true"></div>
	<div class="room-window-glow" aria-hidden="true"></div>
	<div class="room-night-window-glow" aria-hidden="true"></div>
	<div class="room-lamp-glow room-lamp-glow--left" aria-hidden="true"></div>
	<div class="room-lamp-glow room-lamp-glow--right" aria-hidden="true"></div>
	<div class="reading-room__content">
		<slot />
	</div>
</div>

<style>
	.reading-room {
		position: relative;
		display: grid;
		width: 100%;
		padding: 0;
		place-items: center;
		isolation: isolate;
		min-height: calc(100vh - 5rem);
		min-height: calc(100dvh - 5rem);
		background-color: #171513;
		background-image: var(--room-background-image);
		background-position: center;
		background-size: cover;
	}

	.room-backdrop {
		position: absolute;
		inset: 0;
	}

	.room-backdrop {
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.room-backdrop::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		background: radial-gradient(
			ellipse at center,
			transparent 44%,
			rgb(15 9 5 / 8%) 72%,
			rgb(15 9 5 / 30%) 100%
		);
		content: "";
	}

	.room-window-glow {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: radial-gradient(
			ellipse at 50% 48%,
			rgb(255 190 82 / 22%) 0%,
			rgb(255 174 65 / 12%) 24%,
			transparent 52%
		);
		animation: room-window-breathe 9s ease-in-out infinite alternate;
		opacity: 0.58;
		pointer-events: none;
		transition: opacity 600ms ease;
	}

	.room-night-overlay,
	.room-night-vignette,
	.room-night-window-glow,
	.room-lamp-glow {
		position: absolute;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		transition: opacity 600ms ease;
	}

	.room-night-overlay {
		inset: 0;
		background: rgb(10 16 35 / 45%);
	}

	.room-night-vignette {
		inset: 0;
		background: radial-gradient(ellipse at center, transparent 42%, rgb(3 8 24 / 20%) 72%, rgb(3 8 24 / 43%) 100%);
	}

	.room-night-window-glow {
		top: 48%;
		left: 50%;
		width: min(78vw, 72rem);
		height: min(64vh, 42rem);
		transform: translate(-50%, -50%);
		background: radial-gradient(ellipse at center, rgb(22 40 91 / 38%) 0%, rgb(17 32 76 / 24%) 34%, transparent 72%);
	}

	.room-lamp-glow {
		top: 32%;
		width: clamp(17rem, 34vw, 34rem);
		height: clamp(14rem, 29vw, 29rem);
		transform: translate(-50%, -50%);
		isolation: isolate;
	}

	.room-lamp-glow--left { left: 36%; }
	.room-lamp-glow--right { left: 64%; }

	.room-lamp-glow::before {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at center, rgb(255 207 122 / 72%) 0%, rgb(255 207 122 / 42%) 25%, rgb(255 185 78 / 20%) 52%, transparent 76%);
		animation: lamp-flicker 4.2s ease-in-out infinite alternate;
		content: "";
		pointer-events: none;
	}

	.room-dust {
		position: absolute;
		z-index: 1;
		inset: 0;
		background-image:
			radial-gradient(circle, rgb(255 239 193 / 40%) 0 1px, transparent 1.5px),
			radial-gradient(circle, rgb(255 239 193 / 26%) 0 1px, transparent 1.5px),
			radial-gradient(circle, rgb(255 239 193 / 22%) 0 1px, transparent 1.5px);
		background-position: 12% 35%, 65% 62%, 84% 28%;
		background-size: 15rem 12rem, 18rem 14rem, 21rem 17rem;
		animation: dust-drift 18s ease-in-out infinite alternate;
		opacity: 0.35;
	}

	.reading-room__content {
		position: relative;
		z-index: 2;
		display: grid;
		width: 100%;
		min-height: inherit;
		place-items: center;
		padding: clamp(0.5rem, 2vh, 1.5rem) 0;
	}

	@keyframes dust-drift {
		from {
			transform: translate3d(0, 0, 0);
			opacity: 0.2;
		}

		to {
			transform: translate3d(0.3rem, -0.55rem, 0);
			opacity: 0.42;
		}
	}

	@keyframes room-window-breathe {
		from { opacity: 0.42; }
		to { opacity: 0.72; }
	}

	@keyframes lamp-flicker {
		from { opacity: 0.72; }
		to { opacity: 1; }
	}

	:global(html[data-theme="dark"]) .room-night-overlay,
	:global(html[data-theme="dark"]) .room-night-vignette,
	:global(html[data-theme="dark"]) .room-night-window-glow,
	:global(html[data-theme="dark"]) .room-lamp-glow {
		opacity: 1;
	}

	:global(html[data-theme="dark"]) .room-window-glow {
		animation: none;
		opacity: 0;
	}

	@media (max-width: 48rem) {
		.reading-room {
			min-height: calc(100vh - 7.5rem);
			min-height: calc(100dvh - 7.5rem);
		}

		.reading-room__content {
			padding: 0.5rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.room-dust,
		.room-window-glow,
		.room-lamp-glow::before {
			animation: none;
		}
		.room-night-overlay,
		.room-night-vignette,
		.room-night-window-glow,
		.room-window-glow,
		.room-lamp-glow { transition: none; }
	}

	:global(html.reduce-motion-active) .room-dust,
	:global(html.reduce-motion-active) .room-window-glow {
		animation: none;
	}

	:global(html.reduce-motion-active) .room-lamp-glow::before {
		animation-play-state: paused;
	}

	:global(html.reduce-motion-active) .room-night-overlay,
	:global(html.reduce-motion-active) .room-night-vignette,
	:global(html.reduce-motion-active) .room-night-window-glow,
	:global(html.reduce-motion-active) .room-window-glow,
	:global(html.reduce-motion-active) .room-lamp-glow {
		transition: none;
	}
</style>
