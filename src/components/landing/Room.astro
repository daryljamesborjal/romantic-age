---
// Full-screen photographic reading room with theme-aware light and subtle dust.
---

<div class="reading-room">
	<!-- The photograph, contrast overlay, and dust are purely decorative. -->
	<div class="room-backdrop" aria-hidden="true">
		<div class="room-dust"></div>
	</div>
	<div class="reading-room__content">
		<slot />
	</div>
</div>

<style>
	.reading-room {
		position: relative;
		display: grid;
		width: 100%;
		padding: 0;
		place-items: center;
		isolation: isolate;
		min-height: 100vh;
		min-height: 100dvh;
		overflow: hidden;
		background-color: #171513;
		background-image: url('/images/library-room.jpg');
		background-position: center;
		background-size: cover;
	}

	.room-backdrop {
		position: absolute;
		inset: 0;
	}

	.room-backdrop {
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.room-backdrop::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		background:
			linear-gradient(to bottom, var(--landing-overlay-top), var(--landing-overlay-bottom)),
			radial-gradient(circle at center, transparent 50%, var(--landing-vignette) 100%);
		content: "";
	}

	.room-dust {
		position: absolute;
		z-index: 1;
		inset: 0;
		background-image:
			radial-gradient(circle, rgb(255 239 193 / 40%) 0 1px, transparent 1.5px),
			radial-gradient(circle, rgb(255 239 193 / 26%) 0 1px, transparent 1.5px),
			radial-gradient(circle, rgb(255 239 193 / 22%) 0 1px, transparent 1.5px);
		background-position: 12% 35%, 65% 62%, 84% 28%;
		background-size: 15rem 12rem, 18rem 14rem, 21rem 17rem;
		animation: dust-drift 18s ease-in-out infinite alternate;
		opacity: 0.35;
	}

	.reading-room__content {
		position: relative;
		z-index: 2;
		display: grid;
		width: 100%;
		min-height: inherit;
		place-items: center;
		padding: clamp(1.5rem, 4vw, 3rem) 0;
	}

	@keyframes dust-drift {
		from {
			transform: translate3d(0, 0, 0);
			opacity: 0.2;
		}

		to {
			transform: translate3d(0.3rem, -0.55rem, 0);
			opacity: 0.42;
		}
	}

	@media (max-width: 48rem) {
		.reading-room__content {
			padding: 1.5rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.room-dust {
			animation: none;
		}
	}
</style>
