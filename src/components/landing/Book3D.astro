---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

interface Work {
	id: string;
	title: string;
	author: string;
	year: string;
	href: string;
	spineTitle: string;
	coverColor: string;
	accentColor: string;
	thickness: number;
	height: string;
	tilt: number;
	emblem: "moon-waves" | "theatre-mask" | "daffodil";
}

interface Props {
	work: Work;
	delay?: number;
	forward?: number;
}

const { work, delay = 0, forward = 0 } = Astro.props;
const initials = `${work.author.split(/\s+/).map((name) => name[0]).join(".")}.`;
const bookHeightRatio = Number.parseFloat(work.height) / 100;
const hasCoverTexture = existsSync(resolve(process.cwd(), "public", "textures", "cover.webp"));
---

<a
	class="book-link"
	href={work.href}
	aria-label={`Open ${work.title} by ${work.author}`}
	style={`--book-cover-color:${work.coverColor};--book-accent-color:${work.accentColor};--book-depth:clamp(${work.thickness}px,calc(${work.thickness}px + 0.5vh),${work.thickness * 1.18}px);--book-half-depth:calc(${work.thickness / 2}px + 0.25vh);--book-front-z:calc(${work.thickness / 2}px + 0.25vh);--book-back-z:calc(-${work.thickness / 2}px - 0.25vh);--book-height-min:${300 * bookHeightRatio}px;--book-height-vh:${46 * bookHeightRatio}vh;--book-height-max:${480 * bookHeightRatio}px;--book-tilt:${work.tilt}deg;--book-forward:${forward}px;--book-delay:${delay}s;--book-texture:${hasCoverTexture ? "url('/textures/cover.webp')" : "none"};`}
>
	<span class="book3d-stage" aria-hidden="true">
		<span class="book3d-shadow"></span>
		<span class="book3d-float">
			<span class="book3d">
				<span class="book3d__back-cover"></span>
				<span class="book3d__top-pages"></span>
				<span class="book3d__bottom-pages"></span>
				<span class="book3d__page-edge"></span>
				<span class="book3d__spine">
					<span class="book3d__spine-title">{work.spineTitle}</span>
					<span class="book3d__spine-initials">{initials}</span>
					<span class="book3d__spine-band book3d__spine-band--one"></span>
					<span class="book3d__spine-band book3d__spine-band--two"></span>
					<span class="book3d__spine-band book3d__spine-band--three"></span>
				</span>
				<span class="book3d__ribbon"></span>
				<span class="book3d__front-hinge">
					<span class="book3d__front-cover">
						<span class="book3d__texture"></span>
						<span class="book3d__frame">
							{work.emblem === "moon-waves" && (
								<svg class="book3d__emblem" viewBox="0 0 100 100" aria-hidden="true">
									<path d="M63 12a31 31 0 1 0 25 50A34 34 0 0 1 63 12Z" fill="none" stroke="currentColor" stroke-width="4" />
									<path d="M12 72c12-9 23 9 36 0s24 9 40 0M12 85c12-9 23 9 36 0s24 9 40 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="3" />
								</svg>
							)}
							{work.emblem === "theatre-mask" && (
								<svg class="book3d__emblem" viewBox="0 0 100 100" aria-hidden="true">
									<path d="M14 22c18 7 54 7 72 0v31c0 21-16 34-36 39C30 87 14 74 14 53V22Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="4" />
									<path d="M27 45c8-8 17-6 22 0-7 6-15 7-22 0Zm24 0c8-8 17-6 22 0-7 6-15 7-22 0ZM35 68c9-7 21-7 30 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" />
								</svg>
							)}
							{work.emblem === "daffodil" && (
								<svg class="book3d__emblem" viewBox="0 0 100 100" aria-hidden="true">
									<path d="M49 54c-2 16-1 28 0 37m0-20c-12-8-21-6-27-1 8 11 16 13 27 10m0-16c10-13 22-15 31-12-5 14-14 19-31 20" fill="none" stroke="#69834d" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
									<path d="M50 13c8-10 19-4 15 5 12-1 16 11 5 16 10 8 2 19-8 13-4 12-17 11-18 0-10 8-19-1-11-11-11-5-7-18 5-18-1-12 10-15 12-5Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="3.5" />
									<circle cx="51" cy="34" r="8" fill="currentColor" />
								</svg>
							)}
							<span class="book3d__title">{work.title}</span>
							<span class="book3d__author">{work.author}</span>
							<span class="book3d__year">{work.year}</span>
						</span>
						<span class="book3d__highlight"></span>
					</span>
				</span>
			</span>
		</span>
	</span>
</a>

<style>
	.book-link {
		--book-height: clamp(var(--book-height-min), var(--book-height-vh), var(--book-height-max));
		position: relative;
		display: block;
		width: 100%;
		min-width: 44px;
		min-height: 44px;
		color: inherit;
		text-decoration: none;
	}

	.book-link:focus-visible {
		z-index: 3;
		border-radius: 0.5rem;
		outline: 3px solid var(--book-accent-color);
		outline-offset: 3px;
	}

	.book3d-stage {
		position: relative;
		display: grid;
		width: 100%;
		height: calc(var(--book-h) + 1.25rem);
		place-items: center;
		perspective: 65rem;
	}

	.book3d-shadow {
		position: absolute;
		bottom: 0.35rem;
		left: 50%;
		width: min(88%, 16rem);
		height: 1.4rem;
		transform: translateX(-50%) scale(1);
		border-radius: 50%;
		background: radial-gradient(ellipse, rgb(0 0 0 / 70%) 0%, rgb(0 0 0 / 38%) 44%, transparent 78%);
		animation: book-shadow-drift 5.6s ease-in-out var(--book-delay, 0s) infinite;
		pointer-events: none;
	}

	.book3d-float {
		display: block;
		height: var(--book-height, 100%);
		aspect-ratio: 0.68;
		transform-style: preserve-3d;
		animation: book-bob 5.6s ease-in-out var(--book-delay, 0s) infinite;
	}

	.book3d {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		transform: translateZ(var(--book-forward, 0px)) rotateY(var(--book-tilt, 18deg)) rotateX(2deg);
		transform-style: preserve-3d;
		transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.book3d__back-cover,
	.book3d__spine,
	.book3d__page-edge,
	.book3d__top-pages,
	.book3d__bottom-pages,
	.book3d__front-hinge {
		position: absolute;
		display: block;
		transform-style: preserve-3d;
	}

	.book3d__back-cover {
		inset: 0;
		transform: translateZ(var(--book-back-z)) rotateY(180deg);
		border: 1px solid color-mix(in srgb, var(--book-cover-color) 68%, #100905 32%);
		border-radius: 4px;
		background:
			repeating-radial-gradient(circle at 22% 28%, rgb(255 255 255 / 2.5%) 0 0.6px, transparent 1px 5px),
			linear-gradient(145deg, var(--book-cover-color), var(--book-cover-color) 58%, #17100c);
		backface-visibility: hidden;
		box-shadow: inset 0 1px 0 rgb(255 244 211 / 38%), inset 1px 0 0 rgb(255 244 211 / 22%);
	}

	.book3d__spine {
		top: 0;
		bottom: 0;
		left: calc(0px - var(--book-half-depth));
		width: var(--book-depth);
		transform: rotateY(-90deg);
		border: 1px solid rgb(20 12 8 / 85%);
		background: linear-gradient(90deg, #120c09, var(--book-cover-color) 24%, #180e0b 52%, var(--book-cover-color) 80%, #100a08);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--book-accent-color) 58%, transparent);
		color: var(--book-accent-color);
	}

	.book3d__spine-title {
		position: absolute;
		top: 22%;
		left: 50%;
		max-height: 56%;
		transform: translateX(-50%);
		font-size: clamp(0.42rem, 1vh, 0.6rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-align: center;
		text-orientation: mixed;
		writing-mode: vertical-rl;
	}

	.book3d__spine-initials {
		position: absolute;
		bottom: 4%;
		left: 50%;
		transform: translateX(-50%);
		font-size: clamp(0.36rem, 0.7vh, 0.48rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.book3d__spine-band {
		position: absolute;
		right: 8%;
		left: 8%;
		height: clamp(1px, 0.2vh, 2px);
		background: linear-gradient(90deg, #8a672a, #f3df9d 42%, #98732d 74%, #e3c66e);
		box-shadow: 0 1px 1px rgb(0 0 0 / 55%);
	}

	.book3d__spine-band--one { top: 12%; }
	.book3d__spine-band--two { top: 17%; }
	.book3d__spine-band--three { bottom: 13%; }

	.book3d__page-edge {
		top: 4px;
		bottom: 4px;
		right: calc(8px - var(--book-half-depth));
		width: calc(var(--book-depth) - 8px);
		transform: rotateY(90deg);
		border: 1px solid rgb(150 132 102 / 46%);
		border-radius: 0 3px 3px 0;
		background:
			linear-gradient(90deg, rgb(109 87 56 / 18%), transparent 28% 82%, rgb(109 87 56 / 10%)),
			repeating-linear-gradient(to bottom, #fffdf7 0 1px, #e6dcc6 1px 2px, #fffdf7 2px 3px);
		box-shadow: inset 3px 0 5px rgb(86 67 43 / 18%), inset 1px 0 1px rgb(255 255 255 / 75%);
	}

	.book3d__top-pages,
	.book3d__bottom-pages {
		right: 4px;
		left: 4px;
		height: calc(var(--book-depth) - 8px);
		border: 1px solid rgb(150 132 102 / 36%);
		background: repeating-linear-gradient(to bottom, #fffdf7 0 1px, #e6dcc6 1px 2px, #fffdf7 2px 3px);
	}

	.book3d__top-pages {
		top: calc(8px - var(--book-half-depth));
		transform: rotateX(90deg);
	}

	.book3d__bottom-pages {
		bottom: calc(8px - var(--book-half-depth));
		transform: rotateX(-90deg);
	}

	.book3d__ribbon {
		position: absolute;
		z-index: 2;
		right: 18%;
		bottom: -3rem;
		width: clamp(0.55rem, 0.25vh, 0.8rem);
		height: clamp(2.5rem, 7vh, 4rem);
		transform: translateZ(calc(var(--book-front-z) - 2px));
		background: linear-gradient(90deg, #8d1f35, #d15b4e 50%, #7f182f);
		clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
	}

	.book3d__front-hinge {
		inset: 0;
		transform: translateZ(var(--book-front-z));
		transform-origin: left center;
		transition: transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.book3d__front-cover {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 2px solid color-mix(in srgb, var(--book-cover-color) 68%, #100905 32%);
		border-radius: 4px;
		background-image:
			linear-gradient(135deg, rgb(255 255 255 / 15%), transparent 36%, rgb(0 0 0 / 34%)),
			repeating-radial-gradient(circle at 22% 28%, rgb(255 255 255 / 3%) 0 0.6px, transparent 1px 5px),
			linear-gradient(145deg, color-mix(in srgb, var(--book-cover-color) 92%, #fff 8%), var(--book-cover-color) 58%, color-mix(in srgb, var(--book-cover-color) 72%, #100905 28%));
		backface-visibility: hidden;
		box-shadow:
			inset 0 1px 0 rgb(255 244 211 / 48%),
			inset 1px 0 0 rgb(255 244 211 / 30%),
			inset -1px 0 0 rgb(0 0 0 / 22%),
			inset 0 -1px 0 rgb(0 0 0 / 20%),
			inset 0.35rem 0 0.75rem rgb(255 255 255 / 10%),
			inset -0.45rem 0 0.75rem rgb(0 0 0 / 34%);
	}

	.book3d__texture {
		position: absolute;
		z-index: 0;
		inset: 0;
		border-radius: 2px;
		background-image: var(--book-texture);
		background-repeat: repeat;
		background-size: 256px 256px;
		opacity: 0.25;
		pointer-events: none;
	}

	.book3d__frame {
		position: relative;
		z-index: 1;
		display: flex;
		width: 78%;
		height: 84%;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		gap: clamp(0.55rem, 1.5vh, 1.05rem);
		padding: 1rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--book-accent-color) 76%, transparent);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 18%);
		text-align: center;
	}

	.book3d__emblem {
		width: clamp(2.4rem, 5vw, 4.1rem);
		height: clamp(2.4rem, 5vw, 4.1rem);
		flex: 0 0 auto;
		color: var(--book-accent-color);
		opacity: 0.94;
	}

	.book3d__title {
		display: inline-block;
		background: linear-gradient(105deg, #f6e0a0 0%, #f2d98a 28%, #fff3c5 48%, #f2d98a 72%, #f6e0a0 100%);
		background-clip: text;
		color: transparent;
		font-size: clamp(0.88rem, 1.35vw, 1.13rem);
		font-weight: 700;
		line-height: 1.28;
		text-shadow: 0 1px 1px rgb(0 0 0 / 56%);
		text-wrap: balance;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.book3d__author {
		color: color-mix(in srgb, var(--book-accent-color) 80%, #fff 20%);
		font-size: clamp(0.62rem, 0.95vw, 0.76rem);
		letter-spacing: 0.06em;
	}

	.book3d__year {
		color: var(--book-accent-color);
		font-size: 0.62rem;
		letter-spacing: 0.18em;
	}

	.book3d__highlight {
		position: absolute;
		z-index: 2;
		inset: 0;
		transform: translateZ(1px);
		background: radial-gradient(circle at var(--mx, 50%) var(--my, 18%), rgb(255 246 201 / 34%), transparent 48%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.book-link:hover .book3d {
			transform: translateZ(var(--book-forward, 0px)) rotateY(calc(var(--book-tilt, 18deg) - 8deg)) rotateX(5deg) translateY(-10px);
		}

		.book-link:hover .book3d__highlight,
		.book-link:focus-visible .book3d__highlight {
			opacity: 1;
		}
	}

	.book-link:focus-visible .book3d {
		transform: translateZ(var(--book-forward, 0px)) rotateY(calc(var(--book-tilt, 18deg) - 8deg)) rotateX(5deg) translateY(-10px);
	}

	@keyframes book-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	@keyframes book-shadow-drift {
		0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.58; }
		50% { transform: translateX(-50%) scale(0.82); opacity: 0.35; }
	}

	@media (max-width: 48rem) {
		.book3d__title {
			font-size: clamp(0.94rem, 4.1vw, 1.16rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book3d-float,
		.book3d-shadow {
			animation: none;
		}

		.book3d,
		.book3d__front-hinge,
		.book3d__highlight {
			transition: none;
		}

		.book-link:hover .book3d,
		.book-link:focus-visible .book3d {
			transform: translateZ(var(--book-forward, 0px)) rotateY(var(--book-tilt, 18deg)) rotateX(2deg);
		}

		.book3d__highlight {
			display: none;
		}
	}

	:global(html.reduce-motion-active) .book3d-float,
	:global(html.reduce-motion-active) .book3d-shadow {
		animation: none !important;
	}

	:global(html.reduce-motion-active) .book3d,
	:global(html.reduce-motion-active) .book3d__front-hinge,
	:global(html.reduce-motion-active) .book3d__highlight {
		transition: none !important;
	}

	:global(html.reduce-motion-active) .book-link:hover .book3d,
	:global(html.reduce-motion-active) .book-link:focus-visible .book3d {
		transform: translateZ(var(--book-forward, 0px)) rotateY(var(--book-tilt, 18deg)) rotateX(2deg) !important;
	}

	:global(html.reduce-motion-active) .book3d__highlight {
		display: none;
	}
</style>
