---
// Reusable, CSS-only book link for the landing page's three literary works.
type BookTheme = "gothic-sea" | "gothic-catacombs" | "daffodils";

interface Props {
	title: string;
	author: string;
	link: string;
	theme: BookTheme;
	ariaLabel?: string;
}

const { title, author, link, theme, ariaLabel } = Astro.props;
---

<a class="book-link" href={link} aria-label={ariaLabel ?? `Read ${title} by ${author}`}>
	<span class="book-link__art" aria-hidden="true">
		<span class:list={["book", `book--${theme}`]}>
			<!-- The rear board sits behind a thick page block and the front board. -->
			<span class="book-back-cover"></span>
			<span class="book-top-pages"></span>
			<span class="book-pages"></span>
			<span class="book-spine"></span>
			<span class="book-cover">
				<span class="book__cover-frame">
					<span class="book__title">{title}</span>
					<span class="book__author">{author}</span>
				</span>
			</span>
		</span>
	</span>
</a>

<style>
	.book-link {
		--book-cover: #101b31;
		--book-cover-light: #263a59;
		--book-spine: #302016;
		--book-leather: #24170f;
		--book-ink: #d4af37;
		--book-depth: 30px;
		--book-front-z: 15px;
		--book-back-z: -15px;
		--book-center-z: 0px;
		--book-leather-grain:
			repeating-radial-gradient(circle at 22% 28%, rgb(255 255 255 / 2.5%) 0 0.55px, transparent 0.9px 5px),
			radial-gradient(ellipse at 23% 17%, rgb(255 255 255 / 8%), transparent 27%),
			radial-gradient(ellipse at 79% 77%, rgb(0 0 0 / 16%), transparent 38%),
			repeating-linear-gradient(0deg, rgb(255 255 255 / 2%) 0 1px, transparent 1px 3px),
			repeating-linear-gradient(90deg, rgb(0 0 0 / 3%) 0 1px, transparent 1px 4px);
		display: block;
		min-width: 0;
		color: #f3efe7;
		text-decoration: none;
	}

	.book-link:focus-visible {
		outline: 3px solid #fff19a;
		outline-offset: 0.6rem;
		border-radius: 0.5rem;
	}

	/* This stage keeps a soft floor shadow separate from the moving book. */
	.book-link__art {
		position: relative;
		display: grid;
		min-height: 18rem;
		place-items: center;
		perspective: 55rem;
	}

	.book-link__art::after {
		position: absolute;
		z-index: 0;
		bottom: 0.3rem;
		left: 50%;
		width: min(100%, 13rem);
		height: 1.65rem;
		transform: translateX(-50%) rotateX(70deg);
		border-radius: 50%;
		background: radial-gradient(ellipse, rgb(0 0 0 / 76%) 0%, rgb(0 0 0 / 42%) 42%, rgb(0 0 0 / 12%) 68%, transparent 82%);
		content: "";
		pointer-events: none;
		transition: opacity 450ms ease, transform 450ms ease;
		opacity: 0.9;
	}

	.book {
		position: relative;
		z-index: 1;
		display: block;
		width: clamp(9.5rem, 21vw, 12rem);
		aspect-ratio: 0.69;
		transform: rotateY(-20deg) rotateX(2deg);
		transform-style: preserve-3d;
		transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.book-link:hover .book,
	.book-link:focus-visible .book {
		transform: rotateY(-15deg) rotateX(5deg) translateY(-10px);
	}

	.book-link:hover .book-link__art::after,
	.book-link:focus-visible .book-link__art::after {
		transform: translateX(-50%) rotateX(70deg) scale(1.12);
		opacity: 0.86;
	}

	.book-cover,
	.book-back-cover,
	.book-spine,
	.book-pages,
	.book-top-pages {
		position: absolute;
		display: block;
	}

	/* Front and back boards form the two broad faces of the closed book. */
	.book-cover,
	.book-back-cover {
		inset: 0;
		border: 1px solid rgb(212 175 55 / 84%);
		border-radius: 2px;
		backface-visibility: hidden;
		box-shadow:
			inset 0 0 0 2px #d4af37,
			inset 0.3rem 0 0.55rem rgb(255 255 255 / 12%),
			inset -0.35rem 0 0.65rem rgb(0 0 0 / 28%);
	}

	.book-cover {
		display: grid;
		transform: translateZ(var(--book-front-z));
		place-items: center;
		background:
			var(--book-leather-grain),
			linear-gradient(135deg, var(--book-cover-light), var(--book-cover) 62%, var(--book-leather));
	}

	.book-cover::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 0.55rem;
		border-radius: 2px 0 0 2px;
		background: linear-gradient(90deg, var(--book-leather), rgb(212 175 55 / 72%) 18%, rgb(255 255 255 / 10%) 24%, transparent 100%);
		content: "";
	}

	/* A soft diagonal sheen adds a top-left highlight over the leather texture. */
	.book-cover::after {
		position: absolute;
		z-index: 0;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(315deg, rgb(255 255 255 / 10%), transparent 36%, rgb(0 0 0 / 12%) 100%);
		content: "";
		pointer-events: none;
	}

	.book-back-cover {
		transform: translateZ(var(--book-back-z)) rotateY(180deg);
		background:
			var(--book-leather-grain),
			linear-gradient(135deg, var(--book-cover-light), var(--book-cover) 62%, var(--book-leather));
	}

	.book-back-cover::before {
		position: absolute;
		inset: 0.7rem;
		border: 1px solid rgb(212 175 55 / 78%);
		box-shadow: inset 0 0 0 1px rgb(212 175 55 / 24%);
		content: "";
	}

	.book__cover-frame {
		position: relative;
		z-index: 1;
		display: flex;
		width: calc(100% - 1.4rem);
		height: calc(100% - 1.4rem);
		align-items: center;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
		padding: 0.75rem 0.45rem;
		border: 1px solid rgb(212 175 55 / 84%);
		border-radius: 0.15rem 0.45rem 0.45rem 0.15rem;
		color: var(--book-ink);
		box-shadow: inset 0 0 0 1px rgb(212 175 55 / 28%), inset 0 0 0 3px rgb(0 0 0 / 16%);
		text-align: center;
	}

	.book__title {
		color: var(--book-ink);
		font-size: clamp(0.92rem, 1.6vw, 1.15rem);
		font-weight: 700;
		line-height: 1.25;
		text-shadow: 0 1px 1px rgb(0 0 0 / 60%);
		text-wrap: balance;
	}

	.book__author {
		color: var(--book-ink);
		font-size: 0.76rem;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 1px rgb(0 0 0 / 60%);
	}

	/* The spine spans the 30px gap between the rear and front boards. */
	.book-spine {
		top: 0;
		bottom: 0;
		left: calc(var(--book-depth) / -2);
		width: var(--book-depth);
		transform: translateZ(var(--book-center-z)) rotateY(-90deg);
		border: 1px solid rgb(12 8 5 / 76%);
		background:
			repeating-linear-gradient(0deg, transparent 0 4.7rem, rgb(212 175 55 / 10%) 4.72rem 4.78rem, rgb(212 175 55 / 88%) 4.78rem 4.9rem, rgb(0 0 0 / 46%) 4.9rem 5.02rem, transparent 5.04rem 5.3rem),
			linear-gradient(90deg, #120b07 0%, rgb(212 175 55 / 58%) 12%, var(--book-leather) 24%, var(--book-spine) 50%, rgb(212 175 55 / 24%) 82%, #100a06 100%);
	}

	/* Cream page edges show on the right and top of the book block. */
	.book-pages {
		top: 2px;
		bottom: 2px;
		right: calc((var(--book-depth) - 4px) / -2 + 2px);
		width: calc(var(--book-depth) - 4px);
		transform: translateZ(var(--book-center-z)) rotateY(90deg);
		border: 1px solid rgb(145 128 99 / 46%);
		border-top-right-radius: 3px;
		border-bottom-right-radius: 3px;
		background:
			linear-gradient(90deg, rgb(108 87 57 / 18%), transparent 24% 82%, rgb(108 87 57 / 10%)),
			repeating-linear-gradient(to bottom, #fdfbf7 0 1px, #e8dfcc 1px 2px, #fdfbf7 2px 3px);
		box-shadow: inset 3px 0 5px rgb(94 75 49 / 18%), inset 1px 0 1px rgb(255 255 255 / 70%);
	}

	.book-top-pages {
		top: calc((var(--book-depth) - 4px) / -2);
		right: 0.2rem;
		left: 0.2rem;
		height: calc(var(--book-depth) - 4px);
		transform: translateZ(var(--book-center-z)) rotateX(90deg);
		border: 1px solid rgb(145 128 99 / 40%);
		background: repeating-linear-gradient(to bottom, #fdfbf7 0 1px, #e8dfcc 1px 2px, #fdfbf7 2px 3px);
	}

	.book--gothic-catacombs {
		--book-cover: #491624;
		--book-cover-light: #702b3a;
		--book-spine: #2b1711;
		--book-leather: #3a1d13;
		--book-ink: #d4af37;
	}

	.book--daffodils {
		--book-cover: #465b3d;
		--book-cover-light: #809268;
		--book-spine: #2a1c12;
		--book-leather: #362116;
		--book-ink: #d4af37;
	}

	@media (max-width: 48rem) {
		.book-link__art {
			min-height: 16rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book,
		.book-link__art::after {
			transition: none;
		}

		.book-link:hover .book,
		.book-link:focus-visible .book {
			transform: rotateY(-20deg) rotateX(2deg);
		}

		.book-link:hover .book-link__art::after,
		.book-link:focus-visible .book-link__art::after {
			transform: translateX(-50%) rotateX(70deg);
			opacity: 0.9;
		}
	}
</style>
