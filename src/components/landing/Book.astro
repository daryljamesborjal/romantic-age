---
// Reusable, CSS-only book link for the landing page's three literary works.
type BookTheme = "gothic-sea" | "gothic-catacombs" | "daffodils";

interface Props {
	title: string;
	author: string;
	link: string;
	theme: BookTheme;
	ariaLabel?: string;
}

const { title, author, link, theme, ariaLabel } = Astro.props;
---

<a class="book-link" href={link} aria-label={ariaLabel ?? `Read ${title} by ${author}`}>
	<span class="book-link__art" aria-hidden="true">
		<span class:list={["book", `book--${theme}`]}>
			<span class="book__back"></span>
			<span class="book__top-pages"></span>
			<span class="book__pages"></span>
			<span class="book__spine"></span>
			<span class="book__cover">
				<span class="book__cover-frame">
					<span class="book__title">{title}</span>
					<span class="book__author">{author}</span>
				</span>
			</span>
		</span>
	</span>
</a>

<style>
	.book-link {
		--book-cover: #172b50;
		--book-cover-light: #254673;
		--book-spine: #0e1c35;
		--book-ink: #f4e8c9;
		--book-depth: 1.15rem;
		display: block;
		min-width: 0;
		color: #f3efe7;
		text-decoration: none;
	}

	.book-link:focus-visible {
		outline: 3px solid #fff19a;
		outline-offset: 0.6rem;
		border-radius: 0.5rem;
	}

	/* This stage keeps a soft floor shadow separate from the moving book. */
	.book-link__art {
		position: relative;
		display: grid;
		min-height: 18rem;
		place-items: center;
		perspective: 55rem;
	}

	.book-link__art::after {
		position: absolute;
		z-index: 0;
		bottom: 1.1rem;
		left: 50%;
		width: min(82%, 10rem);
		height: 1.15rem;
		transform: translateX(-50%) rotateX(70deg);
		border-radius: 50%;
		background: radial-gradient(ellipse, rgb(0 0 0 / 67%) 0%, rgb(0 0 0 / 36%) 45%, transparent 75%);
		filter: blur(0.45rem);
		content: "";
		pointer-events: none;
		transition: opacity 450ms ease, transform 450ms ease;
		opacity: 0.72;
	}

	.book {
		position: relative;
		z-index: 1;
		display: block;
		width: clamp(9.5rem, 21vw, 12rem);
		aspect-ratio: 0.69;
		transform: rotateY(-19deg) rotateX(3deg);
		transform-style: preserve-3d;
		transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 450ms ease;
		filter: drop-shadow(0.35rem 0.75rem 0.65rem rgb(0 0 0 / 34%));
	}

	.book-link:hover .book,
	.book-link:focus-visible .book {
		transform: rotateY(-7deg) rotateX(1deg) translateZ(1rem) translateY(-0.35rem);
		filter: drop-shadow(0.5rem 0.8rem 0.7rem rgb(0 0 0 / 31%));
	}

	.book-link:hover .book-link__art::after,
	.book-link:focus-visible .book-link__art::after {
		transform: translateX(-50%) rotateX(70deg) scale(1.12);
		opacity: 0.86;
	}

	.book__cover,
	.book__back,
	.book__spine,
	.book__pages,
	.book__top-pages {
		position: absolute;
		display: block;
	}

	/* Front and back boards form the two broad faces of the closed book. */
	.book__cover,
	.book__back {
		inset: 0;
		border: 1px solid rgb(245 234 200 / 40%);
		border-radius: 0.25rem 0.65rem 0.65rem 0.25rem;
		backface-visibility: hidden;
	}

	.book__cover {
		display: grid;
		transform: translateZ(calc(var(--book-depth) / 2));
		place-items: center;
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 2%) 0 1px, transparent 1px 3px),
			repeating-linear-gradient(90deg, rgb(0 0 0 / 3%) 0 1px, transparent 1px 4px),
			radial-gradient(ellipse at 50% 32%, rgb(255 255 255 / 12%), transparent 60%),
			linear-gradient(135deg, var(--book-cover-light), var(--book-cover) 62%, var(--book-spine));
		box-shadow: inset 0.3rem 0 0.55rem rgb(255 255 255 / 12%), inset -0.35rem 0 0.65rem rgb(0 0 0 / 25%);
	}

	.book__cover::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 0.55rem;
		border-radius: 0.2rem 0 0 0.2rem;
		background: linear-gradient(90deg, rgb(0 0 0 / 34%), rgb(255 255 255 / 14%), transparent);
		content: "";
	}

	.book__back {
		transform: translateZ(calc(var(--book-depth) / -2)) rotateY(180deg);
		background: linear-gradient(135deg, var(--book-cover), var(--book-spine));
		box-shadow: inset 0 0 1rem rgb(0 0 0 / 18%);
	}

	.book__cover-frame {
		position: relative;
		z-index: 1;
		display: flex;
		width: calc(100% - 1.4rem);
		height: calc(100% - 1.4rem);
		align-items: center;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
		padding: 0.75rem 0.45rem;
		border: 1px solid rgb(244 226 183 / 64%);
		border-radius: 0.15rem 0.45rem 0.45rem 0.15rem;
		color: var(--book-ink);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 12%);
		text-align: center;
	}

	.book__title {
		font-size: clamp(0.92rem, 1.6vw, 1.15rem);
		font-weight: 700;
		line-height: 1.25;
		text-wrap: balance;
	}

	.book__author {
		font-size: 0.76rem;
		letter-spacing: 0.04em;
	}

	/* The spine occupies the left edge and shows subtle raised binding bands. */
	.book__spine {
		top: 0;
		bottom: 0;
		left: calc(var(--book-depth) / -2);
		width: var(--book-depth);
		transform: rotateY(90deg);
		border: 1px solid rgb(0 0 0 / 28%);
		background:
			linear-gradient(90deg, transparent 12%, rgb(255 255 255 / 18%) 17%, transparent 23% 77%, rgb(0 0 0 / 30%) 83%, transparent 89%),
			linear-gradient(180deg, transparent 8%, rgb(229 197 135 / 56%) 8.5%, transparent 9.5% 90%, rgb(229 197 135 / 48%) 90.5%, transparent 91.5%),
			linear-gradient(90deg, var(--book-spine), var(--book-cover));
	}

	/* Cream page edges show on the right and top of the book block. */
	.book__pages {
		top: 0.18rem;
		bottom: 0.18rem;
		right: calc(var(--book-depth) / -2);
		width: var(--book-depth);
		transform: rotateY(90deg);
		border-block: 1px solid rgb(90 78 58 / 55%);
		background: repeating-linear-gradient(180deg, #fff8e9 0 2px, #d9cfb9 3px 4px);
	}

	.book__top-pages {
		top: calc(var(--book-depth) / -2);
		right: 0.2rem;
		left: 0.2rem;
		height: var(--book-depth);
		transform: rotateX(90deg);
		border-inline: 1px solid rgb(90 78 58 / 45%);
		background: repeating-linear-gradient(90deg, #fff8e9 0 0.22rem, #d9cfb9 0.24rem 0.27rem);
	}

	.book--gothic-catacombs {
		--book-cover: #351820;
		--book-cover-light: #692c32;
		--book-spine: #181114;
		--book-ink: #f1d99e;
	}

	.book--daffodils {
		--book-cover: #8cae43;
		--book-cover-light: #d6b836;
		--book-spine: #42613b;
		--book-ink: #172a25;
	}

	@media (max-width: 48rem) {
		.book-link__art {
			min-height: 16rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book,
		.book-link__art::after {
			transition: none;
		}

		.book-link:hover .book,
		.book-link:focus-visible .book {
			transform: rotateY(-19deg) rotateX(3deg);
			filter: drop-shadow(0.35rem 0.75rem 0.65rem rgb(0 0 0 / 34%));
		}

		.book-link:hover .book-link__art::after,
		.book-link:focus-visible .book-link__art::after {
			transform: translateX(-50%) rotateX(70deg);
			opacity: 0.72;
		}
	}
</style>
