---
// A compact theme switch with a persistent, screen-reader-friendly label.
---

<button
	class="theme-toggle"
	id="theme-toggle"
	type="button"
	aria-label="Switch to night mode"
	aria-pressed="false"
>
	<svg class="theme-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<g class="theme-toggle__sun" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7">
			<circle cx="12" cy="12" r="3.7" />
			<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
		</g>
		<path
			class="theme-toggle__moon"
			d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.6 8.6 0 1 0 20.2 15.1Z"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="1.7"
		/>
	</svg>
	<span class="sr-only">Toggle day and night mode</span>
	<span class="theme-toggle__label" aria-hidden="true">Night</span>
</button>

<style>
	.theme-toggle {
		display: grid;
		width: 2.5rem;
		min-height: 2.5rem;
		place-items: center;
		padding: 0.45rem;
		border: 1px solid var(--border-color);
		border-radius: 50%;
		background: var(--card-bg);
		color: var(--text-color);
		cursor: pointer;
	}

	.theme-toggle:hover {
		background: var(--bg-color);
	}

	.theme-toggle__icon {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
	}

	.theme-toggle__label {
		display: none;
	}

	.theme-toggle__moon {
		display: none;
	}

	:global(html[data-theme="dark"]) .theme-toggle__sun {
		display: none;
	}

	:global(html[data-theme="dark"]) .theme-toggle__moon {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>
