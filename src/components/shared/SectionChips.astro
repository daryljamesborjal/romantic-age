---
interface Chip {
	label: string;
	id: string;
}

interface Props {
	items: Chip[];
	ariaLabel?: string;
}

const { items, ariaLabel = "On this page" } = Astro.props;
---

<nav class="section-chips" data-section-chips aria-label={ariaLabel}>
	<div class="section-chips__scroller">
		{items.filter((item) => item.label.trim() && item.label.trim() !== "|" && item.id.trim()).map((item, index) => <a href={`#${item.id}`} aria-current={index === 0 ? "true" : undefined}>{item.label.trim()}</a>)}
	</div>
</nav>

<script>
	const root = document.documentElement;
	const reduceMotion = () => root.classList.contains("reduce-motion-active") || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const siteHeader = document.querySelector<HTMLElement>(".site-header");
	const navs = Array.from(document.querySelectorAll<HTMLElement>("[data-section-chips]"));
	let hasUserScrolledPage = window.scrollY > 0;
	window.addEventListener("scroll", () => {
		if (window.scrollY > 0) hasUserScrolledPage = true;
	}, { passive: true });

	function syncStickyOffset() {
		const offset = siteHeader?.classList.contains("header-hidden") ? 0 : siteHeader?.offsetHeight || 0;
		root.style.setProperty("--section-chips-top", `${offset}px`);
	}
	syncStickyOffset();
	if (siteHeader && "MutationObserver" in window) new MutationObserver(syncStickyOffset).observe(siteHeader, { attributes: true, attributeFilter: ["class"] });
	if (siteHeader && "ResizeObserver" in window) new ResizeObserver(syncStickyOffset).observe(siteHeader);
	window.addEventListener("resize", syncStickyOffset, { passive: true });

	for (const nav of navs) {
		const scroller = nav.querySelector<HTMLElement>(".section-chips__scroller");
		const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']"));
		if (!scroller || !links.length) continue;
		let activeLink = links.find((link) => link.getAttribute("aria-current") === "true") || links[0];
		scroller.scrollLeft = 0;

		function syncFades() {
			const maxScroll = scroller.scrollWidth - scroller.clientWidth;
			const left = scroller.scrollLeft > 2;
			const right = scroller.scrollLeft < maxScroll - 2;
			scroller.classList.toggle("has-overflow", maxScroll > 2);
			scroller.classList.toggle("has-left-overflow", maxScroll > 2 && left);
			scroller.classList.toggle("has-right-overflow", maxScroll > 2 && right);
			scroller.style.setProperty("--chips-fade-left", left ? "1.25rem" : "0px");
			scroller.style.setProperty("--chips-fade-right", right ? "1.25rem" : "0px");
		}
		scroller.addEventListener("scroll", syncFades, { passive: true });
		window.addEventListener("resize", syncFades, { passive: true });
		requestAnimationFrame(() => { scroller.scrollLeft = 0; syncFades(); });

		function revealActiveLink(link: HTMLAnchorElement) {
			const item = link.getBoundingClientRect();
			const viewport = scroller.getBoundingClientRect();
			const delta = item.left < viewport.left ? item.left - viewport.left : item.right > viewport.right ? item.right - viewport.right : 0;
			if (delta) scroller.scrollTo({ left: scroller.scrollLeft + delta, behavior: reduceMotion() ? "auto" : "smooth" });
		}

		links.forEach((link) => link.addEventListener("click", (event) => {
			const target = document.querySelector<HTMLElement>(link.hash);
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "start" });
			history.replaceState(null, "", link.hash);
		}));

		const targets = links.map((link) => {
			const section = document.querySelector<HTMLElement>(link.hash);
			return section ? { link, heading: section.querySelector<HTMLElement>("h1, h2") || section } : null;
		}).filter((target): target is { link: HTMLAnchorElement; heading: HTMLElement } => Boolean(target));
		let scrollFrame = 0;
		function updateActiveFromScroll() {
			scrollFrame = 0;
			if (!hasUserScrolledPage) return;
			const headerHeight = siteHeader?.classList.contains("header-hidden") ? 0 : siteHeader?.getBoundingClientRect().height || 0;
			const chipHeight = nav.getBoundingClientRect().height;
			const clearTop = headerHeight + chipHeight;
			const readingLine = clearTop + Math.max(0, window.innerHeight - clearTop) * 0.35;
			let next = targets[0]?.link;
			for (const target of targets) {
				if (target.heading.getBoundingClientRect().top <= readingLine) next = target.link;
				else break;
			}
			if (!next || next === activeLink) return;
			activeLink = next;
			links.forEach((link) => link === next ? link.setAttribute("aria-current", "true") : link.removeAttribute("aria-current"));
			revealActiveLink(next);
		}
		function scheduleActiveUpdate() {
			if (!scrollFrame) scrollFrame = requestAnimationFrame(updateActiveFromScroll);
		}
		window.addEventListener("scroll", () => {
			if (window.scrollY > 0) hasUserScrolledPage = true;
			scheduleActiveUpdate();
		}, { passive: true });
		window.addEventListener("resize", scheduleActiveUpdate, { passive: true });
		requestAnimationFrame(scheduleActiveUpdate);
	}
</script>
