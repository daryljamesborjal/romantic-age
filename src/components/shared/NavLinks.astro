---
// Shared responsive route navigation. Text remains available to assistive tech on mobile.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentPage = (href: string) => (href.replace(/\/+$/, "") || "/") === currentPath;
---

<ul class="site-nav">
	<li>
		<a class="nav-link" href="/" aria-label="Home" aria-current={isCurrentPage("/") ? "page" : undefined}>
			<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="m3 10 9-7 9 7M5.5 9v11h13V9M9.5 20v-6h5v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
			</svg>
			<span class="nav-text">Home</span>
		</a>
	</li>
	<li>
		<a class="nav-link nav-link--annabel" href="/annabel-lee" aria-label="Annabel Lee" aria-current={isCurrentPage("/annabel-lee") ? "page" : undefined}>
			<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M19.5 15.5A8 8 0 0 1 8.5 4.5a8.5 8.5 0 1 0 11 11Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
			</svg>
			<span class="nav-text">Annabel Lee</span>
		</a>
	</li>
	<li>
		<a class="nav-link nav-link--cask" href="/cask-of-amontillado" aria-label="The Cask of Amontillado" aria-current={isCurrentPage("/cask-of-amontillado") ? "page" : undefined}>
			<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M6 3h12l-1.3 8.2a4.8 4.8 0 0 1-9.4 0L6 3Zm6 13v4m-4 1h8m-8-13h8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
			</svg>
			<span class="nav-text">The Cask of Amontillado</span>
		</a>
	</li>
	<li>
		<a class="nav-link nav-link--daffodils" href="/daffodils" aria-label="I Wandered Lonely as a Cloud" aria-current={isCurrentPage("/daffodils") ? "page" : undefined}>
			<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M12 12v9m0-5c-3 0-4.5-1.5-5-4 3 0 4.5 1.2 5 4Zm0-2c0-2.5 1.5-4 4-4-.2 2.7-1.5 4-4 4Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
				<path d="M12 4.4c1.1-2.5 3.8-1.6 3.5.4 2.8-1 4.1 1.6 2.1 3.1 2.1 1.9.2 4.1-2.2 2.8-.5 2.6-3.3 2.8-3.8.3-1.5 2.2-4.2 1-3.2-1.6-2.8-.6-2.7-3.6 0-4-1.1-2.7 1.7-4.2 3.6-1Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" />
			</svg>
			<span class="nav-text">I Wandered Lonely as a Cloud<span class="nav-petal" aria-hidden="true"></span></span>
		</a>
	</li>
	<li>
		<a class="nav-link" href="/about" aria-label="About" aria-current={isCurrentPage("/about") ? "page" : undefined}>
			<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
				<path d="M12 11v5m0-8h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" />
			</svg>
			<span class="nav-text">About</span>
		</a>
	</li>
	<slot />
</ul>
