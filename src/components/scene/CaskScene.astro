---
// Decorative Carnival-to-catacomb scenery. Its shapes have no semantic content.
const confetti = Array.from({ length: 18 }, (_, index) => index);
const flags = Array.from({ length: 12 }, (_, index) => index);
const confettiColors = ["#ffe184", "#f7b14a", "#f4e9cc", "#8ec5b0", "#d87052"];
---

<div class="cask-scene" aria-hidden="true">
	<div class="cask-scene__sky"></div>
	<div class="cask-scene__carnival">
		<div class="cask-scene__bunting">
			{flags.map((index) => (
				<span class="cask-scene__flag" style={`--flag-x: ${(index * 100) / 11}%;`}></span>
			))}
		</div>
		<div class="cask-scene__ferris-wheel">
			<span class="cask-scene__wheel-spokes"></span>
			<span class="cask-scene__wheel-hub"></span>
			<span class="cask-scene__wheel-stand"></span>
		</div>
		<div class="cask-scene__fireworks" aria-hidden="true">
			<span class="cask-scene__firework cask-scene__firework--one"></span>
			<span class="cask-scene__firework cask-scene__firework--two"></span>
			<span class="cask-scene__firework cask-scene__firework--three"></span>
		</div>
		<div class="cask-scene__confetti">
			{confetti.map((index) => (
				<span
					class="cask-scene__confetti-piece"
					style={`--piece-x: ${(index * 53) % 100}%; --piece-delay: ${(index % 8) * -1.7}s; --piece-duration: ${9 + (index % 5) * 2}s; --piece-color: ${confettiColors[index % confettiColors.length]};`}
				></span>
			))}
		</div>
	</div>
	<div class="cask-scene__catacombs">
		<div class="cask-scene__arch cask-scene__arch--left"></div>
		<div class="cask-scene__arch cask-scene__arch--right"></div>
		<span class="cask-scene__drip cask-scene__drip--one"></span>
		<span class="cask-scene__drip cask-scene__drip--two"></span>
		<span class="cask-scene__drip cask-scene__drip--three"></span>
		<span class="cask-scene__drip cask-scene__drip--four"></span>
		<div class="cask-scene__barrels cask-scene__barrels--left">
			<span class="cask-scene__barrel"></span>
			<span class="cask-scene__barrel"></span>
		</div>
		<div class="cask-scene__barrels cask-scene__barrels--right">
			<span class="cask-scene__barrel"></span>
			<span class="cask-scene__barrel"></span>
		</div>
	</div>
</div>

<style>
	/* This scene fills its positioned hero without creating a scrollable layer. */
	.cask-scene {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.cask-scene__sky,
	.cask-scene__carnival,
	.cask-scene__catacombs {
		position: absolute;
		inset: 0;
	}

	.cask-scene__sky {
		background: var(--cask-scene-background);
	}

	.cask-scene__carnival,
	.cask-scene__catacombs {
		transition: opacity 350ms ease;
	}

	.cask-scene__carnival {
		background: var(--cask-carnival-light);
		opacity: 1;
	}

	.cask-scene__bunting {
		position: absolute;
		top: 0;
		left: 4%;
		width: 92%;
		height: 7rem;
		transition: opacity 350ms ease;
	}

	.cask-scene__bunting::before {
		position: absolute;
		top: 1.4rem;
		left: 0;
		width: 100%;
		transform: rotate(1.5deg);
		border-top: 2px solid var(--cask-bunting-rope);
		content: "";
	}

	.cask-scene__flag {
		position: absolute;
		top: 1.35rem;
		left: var(--flag-x);
		width: clamp(1.15rem, 3vw, 2.2rem);
		height: 2.8rem;
		transform: rotate(1.5deg);
		clip-path: polygon(0 0, 100% 0, 50% 100%);
		background: var(--cask-flag-one);
		opacity: 0.78;
	}

	.cask-scene__flag:nth-child(3n + 2) {
		background: var(--cask-flag-two);
	}

	.cask-scene__flag:nth-child(3n) {
		background: var(--cask-flag-three);
	}

	.cask-scene__confetti {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	/* A restrained, static fairground wheel sits behind the foreground text. */
	.cask-scene__ferris-wheel {
		position: absolute;
		top: 20%;
		right: 8%;
		width: clamp(8rem, 23vw, 19rem);
		aspect-ratio: 1;
		border: 2px solid rgb(39 18 17 / 32%);
		border-radius: 50%;
		background: repeating-conic-gradient(from 0deg, transparent 0deg 29deg, rgb(39 18 17 / 27%) 30deg 31deg, transparent 32deg 59deg);
		opacity: 0.42;
	}

	.cask-scene__ferris-wheel::before {
		position: absolute;
		inset: 12%;
		border: 1px solid rgb(39 18 17 / 25%);
		border-radius: 50%;
		content: "";
	}

	.cask-scene__wheel-hub {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.75rem;
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: rgb(39 18 17 / 38%);
	}

	.cask-scene__wheel-stand {
		position: absolute;
		top: 48%;
		left: 50%;
		width: 54%;
		height: 60%;
		transform: translateX(-50%);
		border-right: 2px solid rgb(39 18 17 / 28%);
		border-left: 2px solid rgb(39 18 17 / 28%);
		clip-path: polygon(43% 0, 57% 0, 100% 100%, 0 100%);
	}

	.cask-scene__fireworks {
		position: absolute;
		inset: 0;
	}

	.cask-scene__firework {
		position: absolute;
		width: clamp(2rem, 4vw, 3.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: repeating-conic-gradient(from 0deg, transparent 0 9deg, rgb(255 239 184 / 86%) 10deg 12deg, transparent 13deg 30deg);
		animation: firework-flash 7s ease-out infinite;
		opacity: 0;
	}

	.cask-scene__firework--one { top: 18%; left: 28%; animation-delay: -2s; }
	.cask-scene__firework--two { top: 30%; left: 61%; animation-delay: -5s; animation-duration: 9s; }
	.cask-scene__firework--three { top: 13%; left: 75%; animation-delay: -7s; animation-duration: 11s; }

	@keyframes firework-flash {
		0%, 72%, 100% { transform: scale(0.5); opacity: 0; }
		76% { transform: scale(0.78); opacity: 0.64; }
		83% { transform: scale(1); opacity: 0.28; }
		90% { transform: scale(1.08); opacity: 0; }
	}

	.cask-scene__confetti-piece {
		position: absolute;
		top: -1rem;
		left: var(--piece-x);
		width: 0.45rem;
		height: 0.45rem;
		transform: translateY(-1rem);
		background: var(--piece-color);
		animation: confetti-fall var(--piece-duration) linear infinite;
		animation-delay: var(--piece-delay);
		opacity: 0;
	}

	.cask-scene__confetti-piece:nth-child(3n) {
		border-radius: 50%;
	}

	.cask-scene__confetti-piece:nth-child(4n) {
		width: 0.3rem;
		height: 0.6rem;
	}

	@keyframes confetti-fall {
		0% {
			transform: translateY(-1rem) rotate(0deg);
			opacity: 0;
		}

		12% {
			opacity: 0.9;
		}

		100% {
			transform: translateY(75vh) rotate(320deg);
			opacity: 0;
		}
	}

	.cask-scene__catacombs {
		background: linear-gradient(180deg, rgb(6 8 8 / 18%), rgb(5 7 7 / 42%));
		opacity: 0;
	}

	.cask-scene__arch {
		position: absolute;
		bottom: -5%;
		width: clamp(13rem, 30vw, 30rem);
		height: 88%;
		border: 1px solid var(--cask-arch-edge);
		border-bottom: 0;
		border-radius: 50% 50% 0 0 / 28% 28% 0 0;
		background: linear-gradient(180deg, var(--cask-arch-fill), rgb(7 9 8 / 88%));
		box-shadow: inset 0.8rem 0 1.4rem rgb(0 0 0 / 17%), inset -0.8rem 0 1.4rem rgb(0 0 0 / 17%);
		opacity: 0.5;
	}

	.cask-scene__arch::before {
		position: absolute;
		top: 17%;
		right: 16%;
		bottom: 0;
		left: 16%;
		border: 1px solid rgb(255 255 255 / 4%);
		border-bottom: 0;
		border-radius: 50% 50% 0 0 / 30% 30% 0 0;
		background: var(--cask-arch-opening);
		content: "";
	}

	.cask-scene__arch--left {
		left: 8%;
	}

	.cask-scene__arch--right {
		right: 7%;
		transform: scale(0.82);
		transform-origin: bottom center;
	}

	.cask-scene__drip {
		position: absolute;
		top: 24%;
		width: 0.2rem;
		height: 2.2rem;
		transform: scaleY(0.35);
		transform-origin: top center;
		border-radius: 999px;
		background: linear-gradient(180deg, var(--cask-drip), transparent);
		animation: water-drip 5.5s ease-in infinite;
		opacity: 0;
	}

	/* Low, dark barrel stacks appear only with the catacomb layer. */
	.cask-scene__barrels {
		position: absolute;
		bottom: -1rem;
		display: flex;
		align-items: flex-end;
		gap: 0.35rem;
		opacity: 0.62;
	}

	.cask-scene__barrels--left { left: 2%; }
	.cask-scene__barrels--right { right: 2%; transform: scale(0.86); transform-origin: bottom right; }

	.cask-scene__barrel {
		position: relative;
		width: clamp(2.5rem, 5vw, 4rem);
		height: clamp(3.5rem, 8vw, 5.5rem);
		border: 2px solid rgb(175 157 124 / 34%);
		border-radius: 24% / 12%;
		background: repeating-linear-gradient(to bottom, transparent 0 22%, rgb(180 162 131 / 27%) 23% 26%, transparent 27% 48%), linear-gradient(90deg, #171614, #39342d 48%, #171614);
	}

	.cask-scene__barrel + .cask-scene__barrel {
		transform: translateY(-2rem) scale(0.86);
		transform-origin: bottom center;
	}

	.cask-scene__drip--one {
		left: 22%;
		animation-delay: -1.2s;
	}

	.cask-scene__drip--two {
		left: 36%;
		top: 31%;
		animation-delay: -3.7s;
	}

	.cask-scene__drip--three {
		right: 34%;
		top: 27%;
		animation-delay: -2.4s;
	}

	.cask-scene__drip--four {
		right: 19%;
		top: 34%;
		animation-delay: -4.5s;
	}

	@keyframes water-drip {
		0% {
			transform: translateY(0) scaleY(0.35);
			opacity: 0;
		}

		18% {
			opacity: 0.7;
		}

		85%,
		100% {
			transform: translateY(8rem) scaleY(1);
			opacity: 0;
		}
	}

	:global(html[data-theme="dark"]) .cask-scene__carnival {
		opacity: 0;
	}

	:global(html[data-theme="dark"]) .cask-scene__confetti-piece {
		animation-play-state: paused;
	}

	:global(html[data-theme="dark"]) .cask-scene__firework {
		animation-play-state: paused;
	}

	:global(html[data-theme="dark"]) .cask-scene__catacombs {
		opacity: 1;
	}

	:global(html[data-theme="dark"]) .cask-scene__drip {
		animation-play-state: running;
	}

	:global(html[data-theme="light"]) .cask-scene__catacombs {
		opacity: 0;
	}

	:global(html[data-theme="light"]) .cask-scene__drip {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.cask-scene__carnival,
		.cask-scene__catacombs,
		.cask-scene__bunting {
			transition: none;
		}

		.cask-scene__confetti-piece,
		.cask-scene__drip,
		.cask-scene__firework {
			animation: none;
		}
	}

	:global(html.reduce-motion-active) .cask-scene__confetti-piece,
	:global(html.reduce-motion-active) .cask-scene__drip,
	:global(html.reduce-motion-active) .cask-scene__firework {
		animation-play-state: paused;
	}

	:global(html.reduce-motion-active) .cask-scene__carnival,
	:global(html.reduce-motion-active) .cask-scene__catacombs,
	:global(html.reduce-motion-active) .cask-scene__bunting {
		transition: none;
	}
</style>
