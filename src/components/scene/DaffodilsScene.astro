---
// Landscape bands preserve their shape; foreground objects use independent SVG canvases.
const flowers = Array.from({ length: 40 }, (_, index) => index);
const reflectionDashes = Array.from({ length: 12 }, (_, index) => index);
const waterSparkles = Array.from({ length: 10 }, (_, index) => index);
const stonePositions = [8, 24, 41, 59, 76, 92];
---

<div class="daffodils-scene" aria-hidden="true">
	<svg class="daffodils-scene__sky" viewBox="0 0 1000 500" preserveAspectRatio="none" focusable="false">
		<defs><linearGradient id="daff-sky" x2="0" y2="1"><stop offset="0" stop-color="var(--daff-sky-top)"/><stop offset="1" stop-color="var(--daff-sky-bottom)"/></linearGradient></defs>
		<rect width="1000" height="500" fill="url(#daff-sky)" />
	</svg>

	<svg class="daffodils-scene__landscape" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMax slice" focusable="false">
		<defs>
			<linearGradient id="daff-lake" x2="0" y2="1"><stop offset="0" stop-color="var(--daff-lake-far)"/><stop offset="1" stop-color="var(--daff-lake-bottom)"/></linearGradient>
			<linearGradient id="daff-shore-fade" x2="0" y2="1"><stop offset="0" stop-color="var(--daff-background)" stop-opacity="0"/><stop offset="1" stop-color="var(--daff-background)"/></linearGradient>
		</defs>
		<g transform="scale(1 .7143)">
			<g transform="translate(0 54)">
				<path class="daffodils-scene__fell daffodils-scene__fell--far" d="M0 365 45 330 91 342 143 278 184 315 232 263 276 302 329 248 380 315 435 275 485 320 533 253 581 295 632 238 682 302 730 268 781 317 829 262 879 307 929 267 1000 324 1000 470 0 470Z" />
				<path class="daffodils-scene__fell daffodils-scene__fell--middle" d="M0 400 58 365 112 380 173 326 220 354 275 310 324 358 380 322 438 373 492 329 545 362 606 313 658 362 715 325 768 370 826 320 878 355 932 323 1000 364 1000 496 0 496Z" />
				<path class="daffodils-scene__fell daffodils-scene__fell--near" d="M0 421 56 405 105 414 161 386 214 408 267 374 320 410 375 385 429 421 482 388 535 416 590 377 644 411 698 387 754 420 810 382 866 414 918 386 1000 414 1000 515 0 515Z" />
				<g class="daffodils-scene__ridge-trees"><circle cx="120" cy="394" r="9"/><circle cx="139" cy="390" r="12"/><circle cx="159" cy="395" r="8"/><circle cx="834" cy="385" r="9"/><circle cx="854" cy="380" r="13"/><circle cx="875" cy="386" r="8"/></g>
			</g>
			<path class="daffodils-scene__lake" d="M0 444 Q110 432 218 444T440 442Q548 432 655 444T875 442Q945 434 1000 440V592H0Z" />
			<g class="daffodils-scene__reflection">{reflectionDashes.map((index) => <path class="daffodils-scene__reflection-dash" style={`--dash-delay:${index * -0.37}s`} d={`M${766 - (index % 3) * 7} ${486 + index * 8}h${(index % 4) * 4 + 8}`} />)}</g>
			<g class="daffodils-scene__wave daffodils-scene__wave--one"><path d="M-20 470 Q75 452 170 470T360 470T550 470T740 470T930 470T1120 470" /></g>
			<g class="daffodils-scene__wave daffodils-scene__wave--two"><path d="M-20 506 Q75 490 170 506T360 506T550 506T740 506T930 506T1120 506" /></g>
			<g class="daffodils-scene__wave daffodils-scene__wave--three"><path d="M-20 540 Q75 523 170 540T360 540T550 540T740 540T930 540T1120 540" /></g>
			<g class="daffodils-scene__sparkles">{waterSparkles.map((index) => <path class="daffodils-scene__sparkle" style={`--sparkle-delay:${index * -0.55}s`} d={`M${80 + ((index * 97) % 840)} ${440 + ((index * 29) % 85)}l2 4 4 2-4 2-2 4-2-4-4-2 4-2z`} />)}</g>
			<path class="daffodils-scene__bank" d="M0 520Q100 501 202 518T410 516Q520 500 626 518T842 515Q925 502 1000 516V700H0Z" />
			<path class="daffodils-scene__bank-front" d="M0 612Q170 580 330 613T650 610Q840 585 1000 614V700H0Z" />
			<path d="M0 610H1000V700H0Z" fill="url(#daff-shore-fade)" />
		</g>
	</svg>

	<svg class="daffodils-scene__orb daffodils-scene__sun day-only" viewBox="0 0 120 120" focusable="false">
		<defs><radialGradient id="daff-sun-glow"><stop stop-color="#ffe994" stop-opacity=".28"/><stop offset="1" stop-color="#ffe994" stop-opacity="0"/></radialGradient><radialGradient id="daff-sun"><stop stop-color="#fffde7"/><stop offset=".72" stop-color="var(--daff-sun-core)"/><stop offset="1" stop-color="#f6bc47"/></radialGradient></defs>
		<circle cx="60" cy="60" r="60" fill="url(#daff-sun-glow)"/><circle cx="60" cy="60" r="49" fill="url(#daff-sun)"/>
	</svg>
	<svg class="daffodils-scene__orb daffodils-scene__moon night-only" viewBox="0 0 120 120" focusable="false">
		<defs><radialGradient id="daff-moon"><stop stop-color="#fff"/><stop offset="1" stop-color="var(--daff-moon-core)"/></radialGradient><radialGradient id="daff-moon-glow"><stop stop-color="#dce7ff" stop-opacity=".22"/><stop offset="1" stop-color="#dce7ff" stop-opacity="0"/></radialGradient></defs>
		<circle cx="60" cy="60" r="60" fill="url(#daff-moon-glow)"/><circle cx="60" cy="60" r="49" fill="url(#daff-moon)"/>
	</svg>

	{[0, 1, 2].map((index) => (
		<svg class={`daffodils-scene__cloud daffodils-scene__cloud--${index + 1}`} viewBox="0 0 180 80" focusable="false">
			<path d="M18 67C-1 65 0 42 18 37c2-24 35-34 50-14 21-14 51-2 50 21 25-1 40 9 40 23z" />
		</svg>
	))}

	<svg class="daffodils-scene__tree daffodils-scene__tree--left" viewBox="0 0 180 300" focusable="false">
		<path class="daffodils-scene__trunk" d="M42 300q18-62 12-123l-18-47 28 39 22-47-8 57q-3 57 18 121z" />
		<g class="daffodils-scene__leaves"><path d="M0 248q-7-33 29-44-2-38 35-44 19-36 49-6 38-9 47 27 31 15 15 48-2 19-22 25z" /></g>
	</svg>
	<svg class="daffodils-scene__tree daffodils-scene__tree--right" viewBox="0 0 180 300" focusable="false">
		<path class="daffodils-scene__trunk" d="M138 300q-18-62-12-123l18-47-28 39-22-47 8 57q3 57-18 121z" />
		<g class="daffodils-scene__leaves"><path d="M180 248q7-33-29-44 2-38-35-44-19-36-49-6-38-9-47 27-31 15-15 48 2 19 22 25z" /></g>
	</svg>

	{stonePositions.map((position, index) => (
		<svg class={`daffodils-scene__stone daffodils-scene__stone--${index + 1}`} viewBox="0 0 100 45" style={`--stone-x:${position}%;--stone-y:${index % 2 ? 17 : 12}%`} focusable="false">
			<ellipse cx="50" cy="33" rx="46" ry="12" />
			<path d="M10 31q7-19 25-15 14-16 31-2 17-5 25 17z" />
		</svg>
	))}

	<div class="daffodils-scene__flower-field">
		{flowers.map((index) => (
			<svg class="daffodils-scene__flower" viewBox="0 0 80 160" style={`--i:${index};--flower-x:${index * 96 / 39}%;--flower-x-small:${index % 14 * 96 / 13}%;--flower-height:${index % 2 ? 6.1 + index % 3 * .25 : 4.35 + index % 3 * .18}rem;--flower-scale:${index % 2 ? 1 : .72};--petal-color:${index % 2 ? ['#f7e27a','#f4dc70','#f9e78d'][index % 3] : ['#fff0af','#f7e9a1','#fff4c3'][index % 3]};--flower-delay:${index * -.19}s;--flower-duration:${8 + index % 5 * .65}s`}>
				<path class="daffodils-scene__stem" d="M39 157Q38 111 42 66" />
				<path class="daffodils-scene__leaf" d="M40 126Q13 110 11 94q22 3 31 27m-1 20q25-22 32-43-23 8-32 30" />
				<g class="daffodils-scene__blossom" transform="translate(10 10)">
					<g fill="var(--petal-color)"><path d="M29 27C20 16 20 7 27 2c7 4 9 14 7 25z"/><path d="M29 27C17 20 8 18 5 24c3 8 13 11 25 8z"/><path d="M29 29C17 29 9 36 12 44c8 4 17-2 22-12z"/><path d="M31 29c-5 11-2 20 5 22 7-5 5-14-1-23z"/><path d="M34 27c10 7 19 7 23 1-2-8-12-11-24-6z"/><path d="M33 25c9-8 12-17 7-22-8 1-12 10-10 23z"/></g>
					<path d="M28 21c9-3 16-1 21 4l10-4 4 4-9 6c-8 2-17 0-26-3z" fill="var(--daff-trumpet)"/><ellipse cx="60" cy="25" rx="3.3" ry="4.4" fill="#c98716"/>
				</g>
			</svg>
		))}
	</div>
</div>

<style>
	.daffodils-scene { position:absolute; z-index:0; inset:0; overflow:hidden; pointer-events:none; }
	.daffodils-scene__sky,.daffodils-scene__landscape { position:absolute; inset:0; width:100%; height:100%; }
	.daffodils-scene__landscape { overflow:visible; }
	.daffodils-scene__fell--far { fill:var(--daff-fell-far); opacity:.76; }
	.daffodils-scene__fell--middle { fill:var(--daff-fell-mid); }
	.daffodils-scene__fell--near { fill:var(--daff-fell-near); }
	.daffodils-scene__ridge-trees { fill:var(--daff-fell-near); opacity:.9; }
	.daffodils-scene__lake { fill:url(#daff-lake); }
	.daffodils-scene__reflection { fill:none; stroke:#fff3c4; stroke-width:3; stroke-linecap:round; }
	.daffodils-scene__reflection-dash { opacity:.08; animation:daff-water-glint 3.8s ease-in-out infinite; animation-delay:var(--dash-delay); }
	@keyframes daff-water-glint { 50% { opacity:.8; } }
	.daffodils-scene__wave { fill:none; stroke:var(--daff-wave); stroke-width:2; opacity:.55; animation:daff-wave-drift 42s ease-in-out infinite alternate; transform-box:fill-box; transform-origin:center; }
	.daffodils-scene__wave--two { opacity:.38; animation-duration:57s; animation-direction:alternate-reverse; }
	.daffodils-scene__wave--three { opacity:.28; animation-duration:73s; }
	@keyframes daff-wave-drift { to { transform:translateX(18px); } }
	.daffodils-scene__sparkles { fill:#f8f5d7; }
	.daffodils-scene__sparkle { opacity:.1; animation:daff-sparkle 4.6s ease-in-out infinite; animation-delay:var(--sparkle-delay); }
	@keyframes daff-sparkle { 50% { opacity:.9; } }
	.daffodils-scene__bank { fill:var(--daff-bank); }
	.daffodils-scene__bank-front { fill:var(--daff-bank-front); }
	.day-only { display:block; }
	.night-only { display:none; }
	.daffodils-scene__orb { position:absolute; z-index:2; top:10%; right:9%; width:clamp(136px,8vw,164px); aspect-ratio:1; height:auto; }
	.daffodils-scene__cloud { position:absolute; z-index:3; width:clamp(5rem,10vw,10rem); height:auto; fill:rgb(255 255 255 / 52%); animation:daff-cloud-float 34s ease-in-out infinite alternate; }
	.daffodils-scene__cloud--1 { top:8%; left:14%; }
	.daffodils-scene__cloud--2 { top:13%; left:48%; animation-duration:42s; animation-direction:alternate-reverse; }
	.daffodils-scene__cloud--3 { top:9%; right:21%; animation-duration:50s; }
	@keyframes daff-cloud-float { to { transform:translateX(12px); } }
	.daffodils-scene__tree { position:absolute; z-index:5; bottom:6%; width:clamp(6rem,12vw,10rem); height:auto; }
	.daffodils-scene__tree--left { left:-2.5rem; }
	.daffodils-scene__tree--right { right:-2.5rem; }
	.daffodils-scene__trunk,.daffodils-scene__leaves { fill:var(--daff-tree); }
	.daffodils-scene__leaves { animation:daff-tree-sway 19s ease-in-out infinite alternate; transform-box:fill-box; transform-origin:bottom center; }
	.daffodils-scene__tree--right .daffodils-scene__leaves { animation-direction:alternate-reverse; animation-duration:23s; }
	@keyframes daff-tree-sway { to { transform:rotate(1deg); } }
	.daffodils-scene__stone { position:absolute; z-index:4; left:var(--stone-x); bottom:var(--stone-y); width:clamp(3rem,5vw,5rem); height:auto; transform:translateX(-50%); }
	.daffodils-scene__stone ellipse { fill:var(--daff-stone); }
	.daffodils-scene__stone path { fill:var(--daff-moss); }
	.daffodils-scene__flower-field { position:absolute; z-index:6; inset:0; }
	.daffodils-scene__flower { position:absolute; bottom:7%; left:var(--flower-x); width:clamp(1.2rem,2.2vw,2.3rem); height:var(--flower-height); overflow:visible; transform-origin:50% 100%; animation:daff-flower-sway var(--flower-duration) ease-in-out infinite alternate; animation-delay:var(--flower-delay); }
	.daffodils-scene__flower:nth-of-type(odd) { z-index:2; }
	.daffodils-scene__flower:nth-of-type(even) { z-index:3; }
	.daffodils-scene__stem { fill:none; stroke:var(--daff-stem); stroke-width:3.4; stroke-linecap:round; }
	.daffodils-scene__leaf { fill:var(--daff-leaf); }
	@keyframes daff-flower-sway { to { transform:rotate(5deg) scale(var(--flower-scale)); } }
	:global(html[data-theme="dark"]) .night-only { display:block; }
	:global(html[data-theme="dark"]) .day-only { display:none; }
	:global(html[data-theme="dark"]) .daffodils-scene__landscape { --daff-fell-far:#52647c; --daff-fell-mid:#25384f; --daff-fell-near:#142237; --daff-lake-far:#203c59; --daff-lake-bottom:#09172a; --daff-wave:#b5cadc; --daff-bank:#243d2e; --daff-bank-front:#14291f; }
	:global(html[data-theme="dark"]) .daffodils-scene__reflection { stroke:#dce7ff; }
	:global(html[data-theme="dark"]) .daffodils-scene__sparkles { fill:#e8efff; }
	:global(html[data-theme="dark"]) .daffodils-scene__cloud { fill:rgb(206 218 238 / 28%); }
	:global(html[data-theme="dark"]) .daffodils-scene__tree { --daff-tree:#0c1521; }
	:global(html[data-theme="dark"]) .daffodils-scene__stone ellipse { fill:#4a5350; }
	:global(html[data-theme="dark"]) .daffodils-scene__stone path { fill:#627b58; }
	:global(html[data-theme="dark"]) .daffodils-scene__flower { --daff-stem:#58784b; --daff-leaf:#476c40; --daff-trumpet:#d49537; }
	@media (max-width:767px) {
		.daffodils-scene__orb { top:7%; right:8%; width:86px; }
		.daffodils-scene__cloud { width:5rem; }
		.daffodils-scene__cloud--3 { display:none; }
		.daffodils-scene__cloud--2 { left:54%; top:12%; }
		.daffodils-scene__tree { width:6rem; bottom:5%; }
		.daffodils-scene__tree--left { left:-3rem; }
		.daffodils-scene__tree--right { right:-3rem; }
		.daffodils-scene__stone { width:clamp(2.5rem,10vw,3.25rem); }
		.daffodils-scene__flower { left:var(--flower-x-small); width:clamp(1.8rem,7.5vw,2rem); height:calc(var(--flower-height) * .88); }
		.daffodils-scene__flower:nth-of-type(n + 15) { display:none; }
	}
	@media (prefers-reduced-motion:reduce) {
		.daffodils-scene__reflection-dash,.daffodils-scene__wave,.daffodils-scene__sparkle,.daffodils-scene__leaves,.daffodils-scene__cloud,.daffodils-scene__flower { animation:none !important; }
	}
	:global(html.reduce-motion-active) .daffodils-scene__reflection-dash,
	:global(html.reduce-motion-active) .daffodils-scene__wave,
	:global(html.reduce-motion-active) .daffodils-scene__sparkle,
	:global(html.reduce-motion-active) .daffodils-scene__leaves,
	:global(html.reduce-motion-active) .daffodils-scene__cloud,
	:global(html.reduce-motion-active) .daffodils-scene__flower { animation-play-state:paused !important; }
</style>
