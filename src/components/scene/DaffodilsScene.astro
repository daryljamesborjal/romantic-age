---
// Decorative day-to-night sky; every layer is hidden from assistive technology.
const flowers = Array.from({ length: 30 }, (_, index) => index);
const flowerScales = [0.82, 1.08, 0.94, 1.16, 0.9, 1.03];
const flowerDurations = [3.2, 4.4, 5.1, 3.7, 4.8, 4.0];
const fireflies = Array.from({ length: 15 }, (_, index) => index);
---

<div class="daffodils-scene" aria-hidden="true">
	<div class="daffodils-scene__sky"></div>
	<div class="daffodils-scene__celestials">
		<div class="daffodils-scene__sun"></div>
		<div class="daffodils-scene__moon"></div>
	</div>
	<div class="daffodils-scene__clouds">
		<span class="daffodils-scene__cloud daffodils-scene__cloud--one"></span>
		<span class="daffodils-scene__cloud daffodils-scene__cloud--two"></span>
		<span class="daffodils-scene__cloud daffodils-scene__cloud--three"></span>
	</div>
	<div class="daffodils-scene__fireflies">
		{fireflies.map((index) => (
			<span
				class="daffodils-scene__firefly firefly"
				style={`--firefly-x: ${(index * 67 + 9) % 96}%; --firefly-y: ${25 + ((index * 31) % 48)}%; --flight-x: ${0.8 + (index % 4) * 0.25}rem; --flight-x-small: ${(0.8 + (index % 4) * 0.25) * 0.72}rem; --flight-x-negative: ${-(0.8 + (index % 4) * 0.25)}rem; --flight-x-negative-small: ${-((0.8 + (index % 4) * 0.25) * 0.72)}rem; --flight-y: ${0.55 + (index % 3) * 0.22}rem; --flight-y-small: ${(0.55 + (index % 3) * 0.22) * 0.72}rem; --flight-y-negative-small: ${-((0.55 + (index % 3) * 0.22) * 0.72)}rem; --flight-duration: ${18 + (index % 6) * 2}s; --pulse-duration: ${3.6 + (index % 4) * 0.55}s; --firefly-delay: ${index * -1.7}s;`}
			></span>
		))}
	</div>
	<div class="daffodils-scene__edge-fade"></div>
	<div class="daffodils-scene__lake">
		<span class="daffodils-scene__wave daffodils-scene__wave--far"></span>
		<span class="daffodils-scene__wave daffodils-scene__wave--middle"></span>
		<span class="daffodils-scene__wave daffodils-scene__wave--near"></span>
	</div>
	<div class="daffodils-scene__meadow">
		<div class="daffodils-scene__grass" aria-hidden="true"></div>
		<div class="daffodils-scene__frog" aria-hidden="true">
			<span class="daffodils-scene__frog-body"></span>
			<span class="daffodils-scene__frog-head"></span>
			<span class="daffodils-scene__frog-eye"></span>
			<div class="frog-tongue"></div>
		</div>
		{flowers.map((index) => (
			<span
				class="daffodils-scene__flower"
				style={`--i: ${index}; --flower-x: ${(index * 96) / 29}%; --stem-height: ${4.2 + (index % 4) * 0.55}rem; --flower-bottom: ${0.2 + ((index * 3) % 6) * 0.2}rem; --flower-scale: ${flowerScales[index % flowerScales.length]}; --flower-duration: ${flowerDurations[index % flowerDurations.length]}s;`}
			>
				<span class="daffodils-scene__stem"></span>
				<span class="daffodils-scene__blossom"></span>
			</span>
		))}
	</div>
</div>

<style>
	/* The hero owns positioning and clipping; this scene only fills that canvas. */
	.daffodils-scene {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.daffodils-scene__sky {
		position: absolute;
		z-index: 0;
		inset: 0;
		background: linear-gradient(180deg, var(--daff-sky-top), var(--daff-sky-bottom));
	}

	.daffodils-scene__celestials {
		position: absolute;
		z-index: 1;
		inset: 0;
		overflow: hidden;
	}

	.daffodils-scene__sun,
	.daffodils-scene__moon {
		position: absolute;
		top: 10%;
		right: clamp(2rem, 14vw, 13rem);
		width: clamp(4.5rem, 10vw, 8rem);
		aspect-ratio: 1;
		border-radius: 50%;
		transition: transform 900ms ease, opacity 700ms ease;
	}

	.daffodils-scene__sun {
		transform: translateY(0);
		background: radial-gradient(circle at 42% 38%, #fffdf0 0 12%, var(--daff-sun-core) 48%, #f5c96c 100%);
		box-shadow: 0 0 0 0.7rem rgb(255 244 188 / 14%), 0 0 2rem 0.6rem rgb(255 232 156 / 20%);
		opacity: 1;
	}

	.daffodils-scene__moon {
		transform: translateY(100vh);
		background: radial-gradient(circle at 35% 30%, #fff 0, var(--daff-moon-core) 56%, #bfc9e8 100%);
		box-shadow: 0 0 0 0.6rem rgb(222 231 255 / 8%), 0 0 1.5rem 0.35rem rgb(208 220 255 / 20%);
		opacity: 0;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__sun {
		transform: translateY(100vh);
		opacity: 0;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__moon {
		transform: translateY(0);
		opacity: 1;
	}

	.daffodils-scene__clouds {
		position: absolute;
		z-index: 2;
		inset: 0;
		overflow: hidden;
	}

	/* A small, deterministic set of long-path fireflies avoids runtime randomness. */
	.daffodils-scene__fireflies {
		position: absolute;
		z-index: 3;
		inset: 0;
		overflow: hidden;
		visibility: hidden;
	}

	.daffodils-scene__firefly {
		position: absolute;
		top: var(--firefly-y);
		left: var(--firefly-x);
		width: 0.32rem;
		height: 0.32rem;
		transform: translate(0, 0);
		border-radius: 50%;
		background: radial-gradient(circle, #fff7bd 0, #e5d77f 54%, transparent 100%);
		box-shadow: 0 0 0.45rem 0.08rem rgb(244 224 133 / 38%);
		animation: firefly-eight var(--flight-duration) ease-in-out infinite, firefly-pulse var(--pulse-duration) ease-in-out infinite alternate;
		animation-delay: var(--firefly-delay);
		transition: transform 400ms ease, opacity 400ms ease;
		opacity: 0.7;
	}

	.daffodils-scene__firefly.is-caught {
		animation: none;
		transform: scale(0);
		opacity: 0;
	}

	@keyframes firefly-eight {
		0%, 100% { transform: translate(0, 0); }
		12.5% { transform: translate(var(--flight-x-small), var(--flight-y-negative-small)); }
		25% { transform: translate(var(--flight-x), 0); }
		37.5% { transform: translate(var(--flight-x-small), var(--flight-y)); }
		50% { transform: translate(0, 0); }
		62.5% { transform: translate(var(--flight-x-negative-small), var(--flight-y-negative-small)); }
		75% { transform: translate(var(--flight-x-negative), 0); }
		87.5% { transform: translate(var(--flight-x-negative-small), var(--flight-y)); }
	}

	@keyframes firefly-pulse {
		from { opacity: 0.38; }
		to { opacity: 0.82; }
	}

	/* A soft horizon blend remains behind the lake and foreground plants. */
	.daffodils-scene__edge-fade {
		position: absolute;
		z-index: 3;
		right: 0;
		bottom: 0;
		left: 0;
		height: 36%;
		background: linear-gradient(to bottom, transparent, var(--bg-color));
		pointer-events: none;
	}

	.daffodils-scene__lake {
		position: absolute;
		z-index: 4;
		inset: 0;
		overflow: hidden;
	}

	.daffodils-scene__wave {
		position: absolute;
		bottom: -17%;
		left: -15%;
		width: 130%;
		border-radius: 50% 50% 0 0 / 18% 18% 0 0;
		background: linear-gradient(180deg, var(--daff-lake-far), var(--daff-lake-bottom));
		animation: wave-drift 62s ease-in-out infinite alternate;
	}

	.daffodils-scene__wave--far {
		height: 43%;
		opacity: 0.58;
	}

	.daffodils-scene__wave--middle {
		bottom: -20%;
		height: 34%;
		background: linear-gradient(180deg, var(--daff-lake-middle), var(--daff-lake-bottom));
		animation-duration: 84s;
		animation-direction: alternate-reverse;
		opacity: 0.78;
	}

	.daffodils-scene__wave--near {
		bottom: -24%;
		height: 26%;
		background: linear-gradient(180deg, var(--daff-lake-near), var(--daff-lake-bottom));
		animation-duration: 108s;
		opacity: 0.94;
	}

	@keyframes wave-drift {
		from {
			transform: translateX(-2%);
		}

		to {
			transform: translateX(2%);
		}
	}

	.daffodils-scene__meadow {
		position: absolute;
		z-index: 5;
		inset: 0;
	}

	.daffodils-scene__frog {
		position: absolute;
		z-index: 8;
		bottom: 1.2rem;
		left: clamp(1rem, 5vw, 4rem);
		width: 3.4rem;
		height: 1.7rem;
		transform: scale(1.2);
		transform-origin: bottom left;
		color: #101b17;
		opacity: 0;
	}

	.daffodils-scene__frog.is-hopping {
		animation: frog-hop 800ms ease-in-out both;
	}

	.frog-tongue {
		position: absolute;
		top: 0.48rem;
		left: 1.65rem;
		width: 0.22rem;
		height: 3.2rem;
		transform: rotate(180deg) scaleY(0);
		transform-origin: top center;
		border-radius: 999px;
		background: linear-gradient(to top, #d95c79, #f0a0aa);
		opacity: 0.9;
	}

	.frog-tongue.is-striking {
		animation: tongue-strike 800ms ease-in-out both;
	}

	@keyframes frog-hop {
		0%, 100% { transform: translateY(0) scale(1.2, 1); }
		36% { transform: translateY(-30px) scale(1.2, 0.9); }
		72% { transform: translateY(-7px) scale(1.2, 0.96); }
	}

	@keyframes tongue-strike {
		0%, 18% { transform: rotate(180deg) scaleY(0); }
		48%, 68% { transform: rotate(180deg) scaleY(1); }
		100% { transform: rotate(180deg) scaleY(0); }
	}

	.daffodils-scene__frog-body {
		position: absolute;
		bottom: 0;
		left: 0.45rem;
		width: 2.5rem;
		height: 1.15rem;
		border-radius: 55% 55% 35% 35%;
		background: currentColor;
	}

	.daffodils-scene__frog-head {
		position: absolute;
		top: 0.15rem;
		left: 0.7rem;
		width: 1.25rem;
		height: 0.9rem;
		border-radius: 50% 50% 38% 38%;
		background: currentColor;
		box-shadow: -0.18rem -0.1rem 0 -0.02rem currentColor, 0.82rem -0.1rem 0 -0.02rem currentColor;
	}

	.daffodils-scene__frog-eye {
		position: absolute;
		top: 0.1rem;
		left: 1rem;
		width: 0.13rem;
		height: 0.13rem;
		border-radius: 50%;
		background: #b4ac7a;
		box-shadow: 0.72rem 0 0 #b4ac7a;
	}

	.daffodils-scene__frog::before,
	.daffodils-scene__frog::after {
		position: absolute;
		bottom: 0;
		width: 0.8rem;
		height: 0.38rem;
		border-bottom: 0.28rem solid currentColor;
		border-radius: 50%;
		content: "";
	}

	.daffodils-scene__frog::before { left: 0; }
	.daffodils-scene__frog::after { right: 0; }

	.daffodils-scene__grass {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 5rem;
		background:
			repeating-linear-gradient(104deg, transparent 0 0.45rem, var(--daff-grass-blade) 0.48rem 0.55rem, transparent 0.6rem 0.9rem),
			linear-gradient(to bottom, transparent, var(--daff-grass-ground));
		opacity: 0.85;
	}

	.daffodils-scene__flower {
		position: absolute;
		bottom: var(--flower-bottom, 0.65rem);
		left: var(--flower-x);
		width: clamp(1rem, 2.5vw, 1.75rem);
		height: var(--stem-height);
		transform-origin: bottom center;
		animation: flower-sway var(--flower-duration, 4.8s) ease-in-out infinite alternate;
		animation-delay: calc(var(--i) * -0.14s);
	}

	.daffodils-scene__stem {
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0.12rem;
		height: calc(100% - 0.75rem);
		transform: translateX(-50%);
		border-radius: 999px;
		background: var(--daff-stem);
	}

	.daffodils-scene__flower::before,
	.daffodils-scene__flower::after {
		position: absolute;
		bottom: 0.9rem;
		width: 1rem;
		height: 0.38rem;
		border-radius: 100% 0 100% 0;
		background: var(--daff-leaf);
		content: "";
	}

	.daffodils-scene__flower::before {
		left: 50%;
		transform: rotate(-32deg);
		transform-origin: left center;
	}

	.daffodils-scene__flower::after {
		right: 50%;
		bottom: 1.7rem;
		transform: rotate(32deg) scaleX(-1);
		transform-origin: right center;
	}

	.daffodils-scene__blossom {
		position: absolute;
		top: 0;
		left: 50%;
		width: clamp(1.1rem, 2.7vw, 1.85rem);
		aspect-ratio: 1;
		transform: translateX(-50%);
		border-radius: 50%;
		background:
			radial-gradient(circle at 50% 50%, var(--daff-trumpet) 0 19%, transparent 20%),
			radial-gradient(ellipse 32% 25% at 50% 13%, var(--daff-flower) 88%, transparent 100%),
			radial-gradient(ellipse 32% 25% at 50% 87%, var(--daff-flower) 88%, transparent 100%),
			radial-gradient(ellipse 25% 32% at 13% 50%, var(--daff-flower) 88%, transparent 100%),
			radial-gradient(ellipse 25% 32% at 87% 50%, var(--daff-flower) 88%, transparent 100%),
			radial-gradient(ellipse 25% 31% at 24% 24%, var(--daff-flower) 88%, transparent 100%),
			radial-gradient(ellipse 25% 31% at 76% 76%, var(--daff-flower) 88%, transparent 100%);
	}

	@keyframes flower-sway {
		from {
			transform: rotate(-8deg) scale(var(--flower-scale, 1));
		}

		to {
			transform: rotate(8deg) scale(var(--flower-scale, 1));
		}
	}

	.daffodils-scene__cloud {
		position: absolute;
		left: -18rem;
		width: 10rem;
		height: 2.5rem;
		border-radius: 999px;
		background: var(--daff-cloud-color);
		animation: cloud-drift 78s linear infinite;
	}

	.daffodils-scene__cloud::before,
	.daffodils-scene__cloud::after {
		position: absolute;
		bottom: 0.5rem;
		border-radius: 50%;
		background: inherit;
		content: "";
	}

	.daffodils-scene__cloud::before {
		left: 1.5rem;
		width: 3.5rem;
		height: 3.5rem;
	}

	.daffodils-scene__cloud::after {
		right: 1.25rem;
		width: 2.75rem;
		height: 2.75rem;
	}

	.daffodils-scene__cloud--one {
		top: 25%;
		animation-duration: 92s;
	}

	.daffodils-scene__cloud--two {
		top: 43%;
		--cloud-scale: 0.72;
		animation-delay: -34s;
		animation-duration: 112s;
	}

	.daffodils-scene__cloud--three {
		top: 16%;
		--cloud-scale: 0.52;
		animation-delay: -68s;
		animation-duration: 126s;
	}

	@keyframes cloud-drift {
		from {
			transform: translateX(0) scale(var(--cloud-scale, 1));
		}

		to {
			transform: translateX(calc(100vw + 24rem)) scale(var(--cloud-scale, 1));
		}
	}

	:global(html[data-theme="dark"]) .daffodils-scene__wave {
		animation-duration: 92s;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__wave--middle {
		animation-duration: 120s;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__wave--near {
		animation-duration: 148s;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__fireflies {
		visibility: visible;
	}

	:global(html[data-theme="light"]) .daffodils-scene__firefly {
		animation-play-state: paused;
	}

	:global(html[data-theme="dark"]) .daffodils-scene__frog {
		opacity: 0.88;
	}

	@media (prefers-reduced-motion: reduce) {
		.daffodils-scene__cloud,
		.daffodils-scene__wave,
		.daffodils-scene__flower,
		.daffodils-scene__firefly,
		.daffodils-scene__frog.is-hopping,
		.frog-tongue.is-striking {
			animation: none;
		}

		.daffodils-scene__firefly {
			transition: none;
		}

		.daffodils-scene__sun,
		.daffodils-scene__moon {
			transition: none;
		}
	}

	:global(html.reduce-motion-active) .daffodils-scene__cloud {
		animation-play-state: paused;
	}

	:global(html.reduce-motion-active) .daffodils-scene__wave,
	:global(html.reduce-motion-active) .daffodils-scene__flower,
	:global(html.reduce-motion-active) .daffodils-scene__firefly,
	:global(html.reduce-motion-active) .daffodils-scene__frog.is-hopping,
	:global(html.reduce-motion-active) .frog-tongue.is-striking {
		animation-play-state: paused;
	}

	:global(html.reduce-motion-active) .daffodils-scene__sun,
	:global(html.reduce-motion-active) .daffodils-scene__moon {
		transition: none;
	}
</style>

<script>
	// The scene interaction runs only in the dark theme and stops for either
	// the site's motion toggle or the visitor's operating-system preference.
	let frogRoutine: number | undefined;

	function stopFrogRoutine() {
		if (frogRoutine !== undefined) {
			window.clearInterval(frogRoutine);
			frogRoutine = undefined;
		}
	}

	function startFrogRoutine() {
		stopFrogRoutine();
		const scene = document.querySelector<HTMLElement>(".daffodils-scene");
		if (!scene) return;

		frogRoutine = window.setInterval(() => {
			const theme = document.documentElement.getAttribute("data-theme");
			console.log("Frog timer tick:", theme);
			const frog = scene.querySelector<HTMLElement>(".daffodils-scene__frog");
			const tongue = frog?.querySelector<HTMLElement>(".frog-tongue");
			const motionRoot = document.documentElement;
			const reduceMotionEnabled =
				document.body.classList.contains("reduce-motion-active") ||
				motionRoot.classList.contains("reduce-motion-active") ||
				window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (
				theme !== "dark" ||
				reduceMotionEnabled ||
				!frog ||
				!tongue
			) {
				return;
			}

			const fireflies = Array.from(scene.querySelectorAll<HTMLElement>(".firefly"));
			if (fireflies.length === 0) return;
			const availableFireflies = fireflies.filter((firefly) => !firefly.classList.contains("is-caught"));
			if (availableFireflies.length === 0) return;

			const firefly = availableFireflies[Math.floor(Math.random() * availableFireflies.length)];
			frog.classList.add("is-hopping");
			tongue.classList.add("is-striking");
			window.setTimeout(() => frog.classList.remove("is-hopping"), 800);
			window.setTimeout(() => tongue.classList.remove("is-striking"), 800);
			firefly.classList.add("is-caught");
			window.setTimeout(() => firefly.classList.remove("is-caught"), 3000);
		}, 8000);
	}

	// Wait until Astro has rendered the page; DOMContentLoaded is the fallback
	// for a regular document load without client-side navigation.
	document.addEventListener("astro:page-load", () => startFrogRoutine());
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", startFrogRoutine, { once: true });
	} else {
		startFrogRoutine();
	}
	document.addEventListener("astro:before-swap", stopFrogRoutine);
</script>
