---
// Decorative memory and mourning scenes; all visual layers are hidden from AT.
const bats = [
	{ left: "68%", top: "8%", duration: "11s", delay: "-2s" },
	{ left: "78%", top: "18%", duration: "13s", delay: "-7s" },
	{ left: "88%", top: "27%", duration: "10s", delay: "-4s" },
	{ left: "71%", top: "31%", duration: "14s", delay: "-10s" },
	{ left: "91%", top: "9%", duration: "12s", delay: "-5s" },
];
---

<div class="annabel-scene" aria-hidden="true">
	<div class="annabel-scene__sky"></div>
	<div class="annabel-scene__memory">
		<div class="annabel-scene__birds">
			<span class="annabel-scene__bird annabel-scene__bird--one"></span>
			<span class="annabel-scene__bird annabel-scene__bird--two"></span>
			<span class="annabel-scene__bird annabel-scene__bird--three"></span>
		</div>
		<div class="annabel-scene__sea annabel-scene__sea--memory">
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--one"></span>
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--two"></span>
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--three"></span>
		</div>
	</div>
	<div class="annabel-scene__mourning">
		<div class="annabel-scene__moon"></div>
		<div class="annabel-scene__bats" aria-hidden="true">
			{bats.map((bat) => (
				<span
					class="annabel-scene__bat"
					style={`--bat-left: ${bat.left}; --bat-top: ${bat.top}; --bat-duration: ${bat.duration}; --bat-delay: ${bat.delay};`}
				>
					<svg viewBox="0 0 100 46" xmlns="http://www.w3.org/2000/svg" focusable="false">
						<path class="annabel-scene__bat-wing annabel-scene__bat-wing--left" d="M48 19C37 9 24 10 4 4c6 19 18 28 43 29l3-8Z" />
						<path class="annabel-scene__bat-wing annabel-scene__bat-wing--right" d="M52 19C63 9 76 10 96 4c-6 19-18 28-43 29l-3-8Z" />
						<path class="annabel-scene__bat-body" d="m45 17-4-10 9 7 9-7-4 10c5 4 7 10 6 17l-11 8-11-8c-1-7 1-13 6-17Z" />
					</svg>
				</span>
			))}
		</div>
		<div class="annabel-scene__street-lamp" aria-hidden="true">
			<span class="annabel-scene__lamp-post"></span>
			<span class="annabel-scene__lamp-light"></span>
			<div class="annabel-scene__raven" aria-hidden="true">
				<svg class="annabel-scene__raven-svg" viewBox="0 0 170 90" xmlns="http://www.w3.org/2000/svg" focusable="false">
					<g class="annabel-scene__raven-body">
						<path d="M39 57 7 79l42-8 15 17 17-4c18 7 43 7 56-4 12-1 20-7 24-13l-19 1c-8-13-22-20-42-20-23 0-43 7-61 16Z" />
						<g class="annabel-scene__raven-head">
							<path d="M113 42c2-11 12-18 23-16 9 2 14 9 13 18l-10 9-24-2Z" />
							<path d="m146 34 22 8-21 5Z" class="annabel-scene__raven-beak" />
							<circle cx="137" cy="34" r="1.7" class="annabel-scene__raven-eye" />
						</g>
					</g>
					<path class="annabel-scene__raven-wing annabel-scene__raven-wing--far" d="M66 53c9-20 27-31 49-27-7 5-10 10-11 16 14-6 26-5 36 1-13 1-22 7-28 16-15-5-29-6-46-6Z" />
					<path class="annabel-scene__raven-wing annabel-scene__raven-wing--near" d="M62 58c13-13 29-17 48-12-11 3-18 9-21 17 13-3 25-1 35 6-19-4-35-2-49 5l-13-7Z" />
				</svg>
			</div>
		</div>
		<div class="annabel-scene__seraphs" aria-hidden="true">
			<span class="annabel-scene__seraph annabel-scene__seraph--one"></span>
			<span class="annabel-scene__seraph annabel-scene__seraph--two"></span>
			<span class="annabel-scene__seraph annabel-scene__seraph--three"></span>
		</div>
		<div class="annabel-scene__sea annabel-scene__sea--dark">
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--one"></span>
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--two"></span>
			<span class="annabel-scene__sea-wave annabel-scene__sea-wave--three"></span>
		</div>
		<div class="annabel-scene__fog"></div>
		<div class="annabel-scene__iron-fence"></div>
		<div class="annabel-scene__gravestone"><span></span></div>
	</div>
</div>

<style>
	/* The hero establishes the containing block and clips all landscape layers. */
	.annabel-scene {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.annabel-scene__sky,
	.annabel-scene__memory,
	.annabel-scene__mourning {
		position: absolute;
		inset: 0;
	}

	.annabel-scene__sky {
		background: var(--annabel-scene-sky);
	}

	.annabel-scene__memory,
	.annabel-scene__mourning {
		transition: opacity 400ms ease;
	}

	.annabel-scene__memory {
		opacity: 1;
	}

	.annabel-scene__mourning {
		opacity: 0;
	}

	.annabel-scene__sea {
		position: absolute;
		right: -10%;
		bottom: -2%;
		left: -10%;
		height: 39%;
		overflow: hidden;
		background: linear-gradient(180deg, var(--annabel-sea-top), var(--annabel-sea-bottom));
	}

	.annabel-scene__sea-wave {
		position: absolute;
		right: -8%;
		left: -8%;
		height: 50%;
		border-radius: 50% 50% 0 0 / 23% 23% 0 0;
		background: var(--annabel-wave-color);
		opacity: 0.58;
	}

	.annabel-scene__sea-wave--one {
		top: -14%;
	}

	.annabel-scene__sea-wave--two {
		top: 5%;
		right: -18%;
		left: -2%;
		opacity: 0.38;
	}

	.annabel-scene__sea-wave--three {
		top: 24%;
		right: -4%;
		left: -14%;
		opacity: 0.28;
	}

	.annabel-scene__birds {
		position: absolute;
		inset: 0;
		overflow: hidden;
		color: var(--annabel-bird-color);
	}

	.annabel-scene__bird {
		position: absolute;
		left: -3rem;
		width: 1.5rem;
		height: 0.6rem;
		animation: bird-crossing 46s linear infinite;
	}

	.annabel-scene__bird::before,
	.annabel-scene__bird::after {
		position: absolute;
		top: 0.15rem;
		width: 0.8rem;
		height: 0.35rem;
		border-top: 2px solid currentColor;
		content: "";
	}

	.annabel-scene__bird::before {
		left: 0;
		transform: rotate(20deg);
		transform-origin: right center;
	}

	.annabel-scene__bird::after {
		right: 0;
		transform: rotate(-20deg);
		transform-origin: left center;
	}

	.annabel-scene__bird--one {
		top: 25%;
		animation-duration: 58s;
	}

	.annabel-scene__bird--two {
		top: 34%;
		--bird-scale: 0.72;
		animation-delay: -21s;
		animation-duration: 73s;
	}

	.annabel-scene__bird--three {
		top: 19%;
		--bird-scale: 0.55;
		animation-delay: -42s;
		animation-duration: 86s;
	}

	@keyframes bird-crossing {
		from {
			transform: translateX(0) scale(var(--bird-scale, 1));
			opacity: 0;
		}

		12%,
		82% {
			opacity: 0.72;
		}

		to {
			transform: translateX(calc(100vw + 5rem)) scale(var(--bird-scale, 1));
			opacity: 0;
		}
	}

	.annabel-scene__moon {
		position: absolute;
		top: 10%;
		right: 12%;
		width: clamp(5rem, 10vw, 8rem);
		aspect-ratio: 1;
		border: 1px solid rgb(241 239 248 / 72%);
		border-radius: 50%;
		background: radial-gradient(circle at 37% 34%, #fffdf4 0, var(--annabel-moon-core) 48%, #aab2cf 100%);
		box-shadow: 0 0 0 0.75rem rgb(211 219 244 / 8%), 0 0 2rem 0.5rem rgb(202 210 244 / 16%);
	}

	/* Five small silhouettes orbit near the moon without obscuring it. */
	.annabel-scene__bats {
		position: absolute;
		z-index: 2;
		inset: 0;
		pointer-events: none;
	}

	.annabel-scene__bat {
		position: absolute;
		top: var(--bat-top);
		left: var(--bat-left);
		width: clamp(1.2rem, 2.5vw, 2rem);
		aspect-ratio: 100 / 46;
		transform: translate(0, 0);
		opacity: 0.52;
	}

	.annabel-scene__bat svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		fill: #11131e;
	}

	.annabel-scene__bat-wing {
		transform-box: view-box;
		transform-origin: 50px 20px;
	}

	.annabel-scene__bat-body {
		fill: #171925;
	}

	:global(html[data-theme="dark"]) .annabel-scene__bat {
		animation: bat-drift var(--bat-duration) ease-in-out infinite;
		animation-delay: var(--bat-delay);
	}

	:global(html[data-theme="dark"]) .annabel-scene__bat-wing {
		animation: bat-flap 300ms ease-in-out infinite alternate;
		animation-delay: var(--bat-delay);
	}

	@keyframes bat-drift {
		0%, 100% { transform: translate(0, 0); }
		12.5% { transform: translate(7px, -5px); }
		25% { transform: translate(12px, 0); }
		37.5% { transform: translate(7px, 5px); }
		50% { transform: translate(0, 0); }
		62.5% { transform: translate(-7px, -5px); }
		75% { transform: translate(-12px, 0); }
		87.5% { transform: translate(-7px, 5px); }
	}

	@keyframes bat-flap {
		from { transform: scaleY(0.62); }
		to { transform: scaleY(1.08); }
	}

	/* Street furniture and raven stay inside the night layer only. */
	.annabel-scene__street-lamp {
		position: absolute;
		z-index: 1;
		bottom: 8%;
		left: 9%;
		width: 3rem;
		height: 42%;
	}

	.annabel-scene__lamp-post {
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0.24rem;
		height: calc(100% - 2rem);
		transform: translateX(-50%);
		border-radius: 999px 999px 0 0;
		background: linear-gradient(90deg, #10121d, #343343 48%, #11131e);
	}

	.annabel-scene__lamp-post::after {
		position: absolute;
		top: 0.25rem;
		left: 50%;
		width: 1.55rem;
		height: 0.2rem;
		transform: translateX(-50%);
		border-radius: 999px 999px 0 0;
		background: #252534;
		content: "";
	}

	.annabel-scene__lamp-light {
		position: absolute;
		top: 0;
		left: 50%;
		width: 1.2rem;
		height: 1.65rem;
		transform: translateX(-50%);
		border: 1px solid rgb(184 172 139 / 56%);
		border-radius: 45% 45% 25% 25%;
		background: radial-gradient(ellipse at center, #d5c99c 0, #8a8064 32%, #282633 75%);
		box-shadow: 0 0 0.7rem 0.15rem rgb(203 185 126 / 15%);
	}

	.annabel-scene__lamp-light::before {
		position: absolute;
		top: -0.25rem;
		left: 50%;
		width: 1.45rem;
		height: 0.24rem;
		transform: translateX(-50%);
		border-radius: 50%;
		background: #302d3a;
		content: "";
	}

	/* The bird is anchored to the lantern itself, so it lands on its roof. */
	.annabel-scene__raven {
		position: absolute;
		z-index: 5;
		top: 0;
		left: 50%;
		width: clamp(4rem, 8vw, 5.5rem);
		aspect-ratio: 170 / 90;
		transform: translate(-50%, -100%);
		opacity: 1;
	}

	.annabel-scene__raven-svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		transform: scaleX(-1);
		fill: #090b14;
	}

	.annabel-scene__raven-beak {
		fill: #45414b;
	}

	.annabel-scene__raven-eye {
		fill: #d6c991;
	}

	.annabel-scene__raven-head {
		transform-box: view-box;
		transform-origin: 120px 45px;
	}

	.annabel-scene__raven-wing {
		transform-box: view-box;
		transform-origin: 85px 54px;
		transform: rotate(-9deg);
		fill: #1a1d29;
	}

	:global(html[data-theme="dark"]) .annabel-scene__raven {
		animation: raven-fly 2.6s cubic-bezier(0.2, 0.72, 0.25, 1) forwards;
	}

	:global(html[data-theme="dark"]) .annabel-scene__raven-wing {
		animation:
			raven-flap 150ms ease-in-out 0s 17 alternate,
			raven-fold 450ms ease-out 2.55s forwards;
	}

	:global(html[data-theme="dark"]) .annabel-scene__raven-body {
		animation: raven-land 550ms ease-out 2.6s both;
	}

	/* Flight takes 2.6 seconds; the head starts looking around two seconds later. */
	:global(html[data-theme="dark"]) .annabel-scene__raven-head {
		animation: raven-idle 2.4s ease-in-out 4.6s infinite alternate;
	}

	@keyframes raven-fly {
		0% {
			transform: translate(calc(-50% + 100vw), calc(-100% - 100px));
			opacity: 0;
		}

		12% {
			transform: translate(calc(-50% + 200px), calc(-100% - 100px));
			opacity: 1;
		}

		100% {
			transform: translate(-50%, -100%);
			opacity: 1;
		}
	}

	@keyframes raven-flap {
		from { transform: rotate(-13deg); }
		to { transform: rotate(24deg); }
	}

	@keyframes raven-fold {
		from { transform: rotate(24deg); }
		to { transform: rotate(-9deg); }
	}

	@keyframes raven-land {
		0% { transform: translateY(0); }
		45% { transform: translateY(-0.18rem); }
		100% { transform: translateY(0); }
	}

	@keyframes raven-idle {
		0%, 100% { transform: rotate(0deg); }
		50% { transform: rotate(-7deg); }
	}

	/* Pale wing forms suggest seraphim without competing with the moon or title. */
	.annabel-scene__seraphs {
		position: absolute;
		inset: 0;
		opacity: 0.2;
	}

	.annabel-scene__seraph {
		position: absolute;
		width: clamp(4rem, 9vw, 8rem);
		height: 2rem;
		color: var(--annabel-fence-color);
		opacity: 0.58;
	}

	.annabel-scene__seraph::before,
	.annabel-scene__seraph::after {
		position: absolute;
		top: 0.7rem;
		width: 52%;
		height: 1rem;
		border-radius: 100% 0 100% 0;
		background: currentColor;
		content: "";
	}

	.annabel-scene__seraph::before {
		left: 0;
		transform: rotate(18deg);
		transform-origin: right center;
	}

	.annabel-scene__seraph::after {
		right: 0;
		transform: scaleX(-1) rotate(18deg);
		transform-origin: left center;
	}

	.annabel-scene__seraph--one { top: 23%; left: 13%; transform: scale(0.8) rotate(-12deg); }
	.annabel-scene__seraph--two { top: 40%; left: 43%; transform: scale(0.58) rotate(9deg); opacity: 0.62; }
	.annabel-scene__seraph--three { top: 17%; right: 21%; transform: scale(0.48) rotate(-8deg); opacity: 0.48; }

	.annabel-scene__gravestone {
		position: absolute;
		z-index: 2;
		bottom: 7%;
		left: 22%;
		width: clamp(2rem, 4vw, 3.4rem);
		height: clamp(3rem, 8vh, 5rem);
		border: 1px solid rgb(218 222 235 / 22%);
		border-radius: 48% 48% 0.15rem 0.15rem;
		background: linear-gradient(90deg, var(--annabel-fence-color), #171a2b 72%);
		box-shadow: 0 0.35rem 0 rgb(0 0 0 / 22%);
		opacity: 0.72;
	}

	.annabel-scene__gravestone span {
		position: absolute;
		top: 25%;
		left: 50%;
		width: 0.3rem;
		height: 1.2rem;
		transform: translateX(-50%);
		background: rgb(220 224 235 / 22%);
	}

	.annabel-scene__gravestone span::before {
		position: absolute;
		top: 0.28rem;
		left: 50%;
		width: 0.75rem;
		height: 0.25rem;
		transform: translateX(-50%);
		background: inherit;
		content: "";
	}

	.annabel-scene__sea--dark .annabel-scene__sea-wave {
		animation: restless-water 24s ease-in-out infinite alternate;
	}

	.annabel-scene__sea--dark .annabel-scene__sea-wave--two {
		animation-duration: 31s;
		animation-direction: alternate-reverse;
	}

	.annabel-scene__sea--dark .annabel-scene__sea-wave--three {
		animation-duration: 37s;
	}

	@keyframes restless-water {
		from {
			transform: translateX(-2%);
		}

		to {
			transform: translateX(2%);
		}
	}

	.annabel-scene__fog {
		position: absolute;
		bottom: 22%;
		left: -25%;
		width: 150%;
		height: 16%;
		transform: translateX(-5%);
		background: linear-gradient(90deg, transparent 0%, var(--annabel-fog-color) 32%, var(--annabel-fog-color) 68%, transparent 100%);
		animation: fog-drift 44s ease-in-out infinite alternate;
		opacity: 0.24;
	}

	@keyframes fog-drift {
		from {
			transform: translateX(-5%);
			opacity: 0.16;
		}

		to {
			transform: translateX(5%);
			opacity: 0.3;
		}
	}

	.annabel-scene__iron-fence {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 20%;
		background:
			linear-gradient(var(--annabel-fence-color), var(--annabel-fence-color)) 0 15% / 100% 0.28rem no-repeat,
			linear-gradient(var(--annabel-fence-color), var(--annabel-fence-color)) 0 29% / 100% 0.18rem no-repeat,
			repeating-linear-gradient(90deg, transparent 0 1.35rem, var(--annabel-fence-color) 1.35rem 1.48rem, transparent 1.48rem 2.45rem);
		opacity: 0.86;
	}

	:global(html[data-theme="dark"]) .annabel-scene__memory {
		opacity: 0;
	}

	:global(html[data-theme="dark"]) .annabel-scene__mourning {
		opacity: 1;
	}

	:global(html[data-theme="dark"]) .annabel-scene__bird {
		animation-play-state: paused;
	}

	:global(html[data-theme="light"]) .annabel-scene__mourning {
		opacity: 0;
	}

	:global(html[data-theme="light"]) .annabel-scene__raven,
	:global(html[data-theme="light"]) .annabel-scene__raven-wing {
		animation-play-state: paused;
	}

	:global(html[data-theme="light"]) .annabel-scene__fog,
	:global(html[data-theme="light"]) .annabel-scene__sea--dark .annabel-scene__sea-wave {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.annabel-scene__memory,
		.annabel-scene__mourning {
			transition: none;
		}

		.annabel-scene__bird,
		.annabel-scene__fog,
		.annabel-scene__sea--dark .annabel-scene__sea-wave,
		.annabel-scene__raven,
		.annabel-scene__raven-wing,
		.annabel-scene__raven-head,
		.annabel-scene__bat,
		.annabel-scene__bat-wing {
			animation: none;
		}

		.annabel-scene__raven {
			transform: translate(-50%, -100%) !important;
			opacity: 1 !important;
			animation: none !important;
		}

		.annabel-scene__raven-wing {
			transform: rotate(-9deg) !important;
			animation: none !important;
		}

		.annabel-scene__raven-body {
			transform: none !important;
			animation: none !important;
		}

		.annabel-scene__raven-head {
			transform: none !important;
			animation: none !important;
		}

		.annabel-scene__bat {
			transform: translate(0, 0) !important;
			animation: none !important;
		}

		.annabel-scene__bat-wing {
			transform: scaleY(0.62) !important;
			animation: none !important;
		}
	}

	:global(html.reduce-motion-active) .annabel-scene__bird,
	:global(html.reduce-motion-active) .annabel-scene__fog,
	:global(html.reduce-motion-active) .annabel-scene__sea--dark .annabel-scene__sea-wave {
		animation-play-state: paused;
	}

	:global(html.reduce-motion-active) .annabel-scene__raven,
	:global(body.reduce-motion-active) .annabel-scene__raven {
		transform: translate(-50%, -100%) !important;
		opacity: 1 !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__raven-wing,
	:global(body.reduce-motion-active) .annabel-scene__raven-wing {
		transform: rotate(-9deg) !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__raven-body,
	:global(body.reduce-motion-active) .annabel-scene__raven-body {
		transform: none !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__raven-head,
	:global(body.reduce-motion-active) .annabel-scene__raven-head {
		transform: none !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__bat,
	:global(body.reduce-motion-active) .annabel-scene__bat {
		transform: translate(0, 0) !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__bat-wing,
	:global(body.reduce-motion-active) .annabel-scene__bat-wing {
		transform: scaleY(0.62) !important;
		animation: none !important;
	}

	:global(html.reduce-motion-active) .annabel-scene__memory,
	:global(html.reduce-motion-active) .annabel-scene__mourning {
		transition: none;
	}
</style>
