---
// Shared page shell. Individual routes provide a document title and page content.
import "../styles/global.css";
import ThemeToggle from "../components/shared/ThemeToggle.astro";
import NavLinks from "../components/shared/NavLinks.astro";

interface Props {
	title?: string;
	mainClass?: string;
}

const { title = "Romantic Age", mainClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#151515" />
		<title>{title}</title>
		<!-- Apply the saved or system theme before the page paints to avoid a flash. -->
		<script is:inline>
			(() => {
				const themeStorageKey = "romantic-age-theme";
				let savedTheme = null;

				try {
					savedTheme = localStorage.getItem(themeStorageKey);
				} catch {
					// Use the operating system preference when storage is unavailable.
				}

				const theme = savedTheme === "light" || savedTheme === "dark"
					? savedTheme
					: window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";

				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
	</head>
	<body>
		<!-- Decorative reading progress indicator; it never intercepts input. -->
		<div class="progress-container" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
			<div class="progress-bar"></div>
		</div>

		<!-- A skip link lets keyboard users bypass repeated navigation. -->
		<a class="skip-link" href="#main-content">Skip to main content</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-name" href="/">Romantic Age</a>
				<nav aria-label="Main navigation">
					<NavLinks>
						<li><ThemeToggle /></li>
					</NavLinks>
				</nav>
			</div>
		</header>

		<main id="main-content" class:list={["site-main", mainClass]}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<p>Romantic Age | School project</p>
				<button
					class="footer-motion-toggle"
					id="motion-toggle"
					type="button"
					aria-label="Reduce motion"
					aria-pressed="false"
				>
					Reduce Motion
				</button>
			</div>
		</footer>

		<script>
			// Persist the theme choice and expose its current state accessibly.
			const themeStorageKey = "romantic-age-theme";
			const themeRoot = document.documentElement;
			const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");

			function setTheme(theme: "dark" | "light", saveChoice = false) {
				themeRoot.setAttribute("data-theme", theme);
				themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));

				if (saveChoice) {
					try {
						localStorage.setItem(themeStorageKey, theme);
					} catch {
						// Keep the current-page choice if browser storage is unavailable.
					}
				}
			}

			setTheme(themeRoot.getAttribute("data-theme") === "dark" ? "dark" : "light");
			themeToggle?.addEventListener("click", () => {
				setTheme(themeRoot.getAttribute("data-theme") === "dark" ? "light" : "dark", true);
			});

			// Restore the saved choice, or use the operating system setting as a fallback.
			const motionStorageKey = "romantic-age-reduce-motion";
			const motionRoot = document.documentElement;
			const motionToggle = document.querySelector<HTMLButtonElement>("#motion-toggle");
			const stickyHeader = document.querySelector<HTMLElement>(".site-header");
			const progressContainer = document.querySelector<HTMLElement>(".progress-container");
			const progressBar = document.querySelector<HTMLElement>(".progress-bar");
			const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
			let hasSavedMotionChoice = false;
			let savedMotionChoice: string | null = null;

			try {
				savedMotionChoice = localStorage.getItem(motionStorageKey);
				hasSavedMotionChoice = savedMotionChoice === "true" || savedMotionChoice === "false";
			} catch {
				// The OS preference still works when browser storage is unavailable.
			}

			function setReducedMotion(enabled: boolean, saveChoice = false) {
				motionRoot.classList.toggle("reduce-motion-active", enabled);
				motionToggle?.setAttribute("aria-pressed", String(enabled));

				if (saveChoice) {
					hasSavedMotionChoice = true;
					try {
						localStorage.setItem(motionStorageKey, String(enabled));
					} catch {
						// Keep the current-page setting even if browser storage is unavailable.
					}
				}

				if (enabled) {
					stickyHeader?.classList.remove("header-hidden");
				}
			}

			setReducedMotion(hasSavedMotionChoice ? savedMotionChoice === "true" : reducedMotionQuery.matches);

			motionToggle?.addEventListener("click", () => {
				setReducedMotion(!motionRoot.classList.contains("reduce-motion-active"), true);
			});

			// Follow later OS preference changes unless the visitor has made an explicit choice.
			reducedMotionQuery.addEventListener("change", (event) => {
				if (!hasSavedMotionChoice) setReducedMotion(event.matches);
			});

			// Hide the sticky header while scrolling down and reveal it while scrolling up.
			let previousScrollY = window.scrollY;
			let scrollUpdateQueued = false;

			window.addEventListener(
				"scroll",
				() => {
					if (scrollUpdateQueued) return;
					scrollUpdateQueued = true;

					window.requestAnimationFrame(() => {
						scrollUpdateQueued = false;
						const currentScrollY = window.scrollY;

						if (
							motionRoot.classList.contains("reduce-motion-active") ||
							stickyHeader?.contains(document.activeElement) ||
							currentScrollY < 80 ||
							currentScrollY < previousScrollY - 6
						) {
							stickyHeader?.classList.remove("header-hidden");
						} else if (currentScrollY > previousScrollY + 6) {
							stickyHeader?.classList.add("header-hidden");
						}

						previousScrollY = currentScrollY;
					});
				},
				{ passive: true },
			);

			// Keep navigation reachable if keyboard focus enters while the header is hidden.
			stickyHeader?.addEventListener("focusin", () => {
				stickyHeader?.classList.remove("header-hidden");
			});

			// Scale the reading indicator in one animation frame per scroll batch.
			let progressUpdateQueued = false;
			function updateReadingProgress() {
				progressUpdateQueued = false;
				if (!progressContainer || !progressBar) return;

				const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
				const hasScrollableContent = scrollableHeight > 0;
				progressContainer.hidden = !hasScrollableContent;

				if (!hasScrollableContent) return;

				const percentage = Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100));
				progressBar.style.transform = `scaleX(${percentage / 100})`;
				progressContainer.setAttribute("aria-valuenow", String(Math.round(percentage)));
			}

			function queueReadingProgressUpdate() {
				if (progressUpdateQueued) return;
				progressUpdateQueued = true;
				window.requestAnimationFrame(updateReadingProgress);
			}

			window.addEventListener("scroll", queueReadingProgressUpdate, { passive: true });
			window.addEventListener("resize", queueReadingProgressUpdate, { passive: true });
			window.addEventListener("load", queueReadingProgressUpdate, { once: true });
			queueReadingProgressUpdate();
		</script>
	</body>
</html>
