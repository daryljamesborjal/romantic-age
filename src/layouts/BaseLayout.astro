---
// Shared page shell. Individual routes provide a document title and page content.
import "../styles/global.css";

interface Props {
	title?: string;
	mainClass?: string;
}

const { title = "Romantic Age", mainClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#151515" />
		<title>{title}</title>
	</head>
	<body>
		<!-- A skip link lets keyboard users bypass repeated navigation. -->
		<a class="skip-link" href="#main-content">Skip to main content</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-name" href="/">Romantic Age</a>
				<nav aria-label="Main navigation">
					<ul class="site-nav">
						<li><a href="/">Home</a></li>
						<li><a href="/annabel-lee">Annabel Lee</a></li>
						<li><a href="/cask-of-amontillado">The Cask of Amontillado</a></li>
						<li><a href="/daffodils">I Wandered Lonely as a Cloud</a></li>
						<li><a href="/about">About</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main-content" class:list={["site-main", mainClass]}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<p>Romantic Age | School project</p>
				<button
					class="footer-motion-toggle"
					id="motion-toggle"
					type="button"
					aria-label="Reduce motion"
					aria-pressed="false"
				>
					Reduce Motion
				</button>
			</div>
		</footer>

		<script>
			// Restore the saved choice, or use the operating system setting as a fallback.
			const motionStorageKey = "romantic-age-reduce-motion";
			const motionRoot = document.documentElement;
			const motionToggle = document.querySelector<HTMLButtonElement>("#motion-toggle");
			const stickyHeader = document.querySelector<HTMLElement>(".site-header");
			const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
			let hasSavedMotionChoice = false;
			let savedMotionChoice: string | null = null;

			try {
				savedMotionChoice = localStorage.getItem(motionStorageKey);
				hasSavedMotionChoice = savedMotionChoice === "true" || savedMotionChoice === "false";
			} catch {
				// The OS preference still works when browser storage is unavailable.
			}

			function setReducedMotion(enabled: boolean, saveChoice = false) {
				motionRoot.classList.toggle("reduce-motion-active", enabled);
				motionToggle?.setAttribute("aria-pressed", String(enabled));

				if (saveChoice) {
					hasSavedMotionChoice = true;
					try {
						localStorage.setItem(motionStorageKey, String(enabled));
					} catch {
						// Keep the current-page setting even if browser storage is unavailable.
					}
				}

				if (enabled) {
					stickyHeader?.classList.remove("header-hidden");
				}
			}

			setReducedMotion(hasSavedMotionChoice ? savedMotionChoice === "true" : reducedMotionQuery.matches);

			motionToggle?.addEventListener("click", () => {
				setReducedMotion(!motionRoot.classList.contains("reduce-motion-active"), true);
			});

			// Follow later OS preference changes unless the visitor has made an explicit choice.
			reducedMotionQuery.addEventListener("change", (event) => {
				if (!hasSavedMotionChoice) setReducedMotion(event.matches);
			});

			// Hide the sticky header while scrolling down and reveal it while scrolling up.
			let previousScrollY = window.scrollY;
			let scrollUpdateQueued = false;

			window.addEventListener(
				"scroll",
				() => {
					if (scrollUpdateQueued) return;
					scrollUpdateQueued = true;

					window.requestAnimationFrame(() => {
						scrollUpdateQueued = false;
						const currentScrollY = window.scrollY;

						if (
							motionRoot.classList.contains("reduce-motion-active") ||
							stickyHeader?.contains(document.activeElement) ||
							currentScrollY < 80 ||
							currentScrollY < previousScrollY - 6
						) {
							stickyHeader?.classList.remove("header-hidden");
						} else if (currentScrollY > previousScrollY + 6) {
							stickyHeader?.classList.add("header-hidden");
						}

						previousScrollY = currentScrollY;
					});
				},
				{ passive: true },
			);

			// Keep navigation reachable if keyboard focus enters while the header is hidden.
			stickyHeader?.addEventListener("focusin", () => {
				stickyHeader?.classList.remove("header-hidden");
			});
		</script>
	</body>
</html>
