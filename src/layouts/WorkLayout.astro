---
import ContentBody from "../components/content/ContentBody.astro";
import NextWork from "../components/shared/NextWork.astro";
import SectionChips from "../components/shared/SectionChips.astro";
import { works } from "../data/works.js";

interface Props {
	work: any;
}

const { work } = Astro.props;
const sections = work.sections;
const isPoem = Array.isArray(work.text[0]);
const chips = [
	{ label: isPoem ? "Poem" : "Story", id: "text" },
	...sections.map((section: any) => ({
		label: section.chipLabel || (section.id === "resonance" ? "Today" : section.id === "references" ? "Sources" : section.heading),
		id: section.id,
	})),
];
const catalogIndex = works.findIndex((item) => item.id === work.id);
const nextWork = catalogIndex < 0 ? null : works[(catalogIndex + 1) % works.length];
const nextTheme = work.id === "annabel-lee" ? "gothic-sea" : work.id === "cask-of-amontillado" ? "gothic-catacombs" : "daffodils";
const sourceSection = sections.find((section: any) => section.id === "references");
const conclusion = sourceSection?.body.find((block: any) => block.label === "Conclusion")?.text || "";
const sourceList = sourceSection?.body.find((block: any) => block.type === "references")?.items || [];
const yearAndAuthor = `${work.author} · ${work.year}`;
const renderInline = (text = "") => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;").replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/\*([^*]+)\*/g, "<em>$1</em>");
---

<div class={`work-content work-content--${work.id}`}>
	<SectionChips items={chips} ariaLabel="Sections in this work" />

	<section class="work-text-paper" id="text" data-work-section aria-labelledby="work-text-title">
		<header class="work-text-paper__heading">
			<h2 id="work-text-title">{work.title}</h2>
			<p>{yearAndAuthor}</p>
		</header>
		{!isPoem ? (
			<div class="work-text-paper__story" aria-label={`${work.title} by ${work.author}`}>
				{work.text.slice(0, 2).map((paragraph: string) => <p set:html={renderInline(paragraph)} />)}
				<div id="work-text-continuation" class="work-text-paper__continuation" hidden>
					{work.text.slice(2).map((paragraph: string) => <p set:html={renderInline(paragraph)} />)}
				</div>
			</div>
		) : (
			<div class="work-text-paper__poem" aria-label={`${work.title} by ${work.author}`}>
				{work.text.slice(0, 1).map((stanza: string[]) => <p>{stanza.map((line: string) => <span>{line}</span>)}</p>)}
				<div id="work-text-continuation" class="work-text-paper__continuation" hidden>
					{work.text.slice(1).map((stanza: string[]) => <p>{stanza.map((line: string) => <span>{line}</span>)}</p>)}
				</div>
			</div>
		)}
		<button class="work-text-paper__toggle" type="button" aria-expanded="false" aria-controls="work-text-continuation" data-story={!isPoem ? "true" : "false"}>
			{!isPoem ? "Read the full story" : "Show the full poem"}
		</button>
	</section>

	<article class="work-sections" aria-label={`${work.title} study sections`}>
		{sections.filter((section: any) => section.id !== "references").map((section: any) => {
			const isConventions = section.id === "conventions";
			const isAnalysis = section.id === "analysis";
			const isAuthor = section.id === "author";
			const isContext = section.id === "context";
			const isSummary = section.id === "summary";
			const isThemes = section.id === "themes";
			const isSymbols = section.id === "symbols";
			const body = isConventions ? section.body.filter((block: any) => block.type !== "list") : section.body;
			return <section id={section.id} class="work-section" data-work-section aria-labelledby={`${section.id}-title`}>
				<h2 id={`${section.id}-title`}>{section.heading}</h2>
				<div class="work-section__body">
					{isContext && <div class="work-glance" aria-label="At a glance">{work.contextGlance.map((item: any) => <article class="work-glance__item"><h3>{item.label}</h3><p set:html={renderInline(item.value)} /></article>)}</div>}
					{isSummary ? <div class="work-summary">
						<div class="work-summary__characters">{section.summaryItems.filter((item: any) => item.type === "character").map((item: any) => <article class="work-character"><span class="work-character__monogram" aria-hidden="true">{item.label.trim().charAt(0)}</span><div><h3>{item.label}</h3><p set:html={renderInline(item.text)} /></div></article>)}</div>
						{section.summaryItems.filter((item: any) => item.type === "setting").map((item: any) => <p class="work-summary__setting"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.3"/></svg><span set:html={renderInline(item.text)} /></p>)}
						{section.summaryItems.filter((item: any) => item.type === "plot").map((item: any) => <p class="work-summary__plot" set:html={renderInline(item.text)} />)}
					</div> : isThemes ? <div class="work-theme-content">
						<div class="work-theme-grid">{section.body.flatMap((block: any) => block.type === "list" ? block.items.map((item: any) => <article class="work-theme-tile"><h3>{item.label}</h3><p><span>Built from</span> <span set:html={renderInline(item.text)} /></p></article>) : [])}</div>
						{section.body.filter((block: any) => block.type === "paragraph").map((block: any) => <p class="work-highlight-note">{block.label && <strong>{block.label}: </strong>}<span set:html={renderInline(block.text)} /></p>)}
					</div> : isSymbols ? <div class="work-symbol-grid">{section.body.flatMap((block: any) => block.type === "list" ? block.items.map((item: any) => <article class="work-symbol"><svg class="work-symbol__icon" aria-hidden="true" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							{item.icon === "waves" && <><path d="M4 17c5-5 9 5 14 0s9 5 14 0 8 5 12 0"/><path d="M4 27c5-5 9 5 14 0s9 5 14 0 8 5 12 0"/><path d="M4 37c5-5 9 5 14 0s9 5 14 0 8 5 12 0"/></>}
							{item.icon === "wind" && <><path d="M5 16h25c7 0 7-9 1-9-3 0-4 2-4 4"/><path d="M5 24h34c7 0 7 10 0 10-3 0-4-2-4-4"/><path d="M5 32h16"/></>}
							{item.icon === "wings" && <><path d="M24 39C17 30 8 22 6 10c8 3 14 8 18 16 4-8 10-13 18-16-2 12-11 20-18 29Z"/><path d="M24 26v13M12 17l10 12M36 17 26 29"/></>}
							{item.icon === "gravestone" && <><path d="M10 40V19a14 14 0 0 1 28 0v21Z"/><path d="M6 40h36M18 25h12M24 20v10"/></>}
							{item.icon === "moon-star" && <><path d="M29 7a17 17 0 1 0 12 28A17 17 0 0 1 29 7Z"/><path d="m16 12 .9 2.1L19 15l-2.1.9L16 18l-.9-2.1L13 15l2.1-.9L16 12ZM37 17l1.2 2.8L41 21l-2.8 1.2L37 25l-1.2-2.8L33 21l2.8-1.2L37 17Z"/></>}
							{item.icon === "jester" && <><path d="M9 35c2-8 5-13 15-13s13 5 15 13v5H9Z"/><path d="M12 22 8 8l13 10M24 18l4-14 7 13M12 40v3M36 40v3"/><circle cx="8" cy="7" r="2"/><circle cx="28" cy="3" r="2"/><circle cx="35" cy="16" r="2"/></>}
							{item.icon === "shield" && <><path d="M24 5 40 11v12c0 10-7 16-16 20C15 39 8 33 8 23V11Z"/><path d="m15 17 18 14M33 17 15 31"/></>}
							{item.icon === "arch" && <><path d="M7 42V22a17 17 0 0 1 34 0v20M3 42h42M14 42V23a10 10 0 0 1 20 0v19"/></>}
							{item.icon === "trowel" && <><path d="m14 32 18-18 7 7-18 18Z"/><path d="m32 14 4-5 7 7-4 5M8 39l7-7M7 42l4-4"/></>}
							{item.icon === "mask" && <><path d="M6 13c10-5 26-5 36 0l-4 19c-1 6-7 10-14 10s-13-4-14-10Z"/><path d="M12 23c4-4 8-4 12 0-3 6-9 6-12 0ZM24 23c4-4 8-4 12 0-3 6-9 6-12 0ZM24 22v12"/></>}
							{item.icon === "cloud" && <><path d="M12 36h25a8 8 0 0 0 0-16 13 13 0 0 0-25-3 10 10 0 0 0 0 19Z"/></>}
							{item.icon === "flower" && <><path d="M20 17c-5-5-6-10-2-13 5 1 7 6 5 12M18 18c-7-3-11-7-9-11 5-1 9 3 11 9M17 20c-8 0-12-3-11-8 5-2 10 1 13 6M18 23c-6 4-11 4-13 0 2-5 7-6 13-3M21 24c-3 7-2 12 3 14 5-3 5-8 0-14M23 17c4-6 9-8 13-5-1 5-5 8-11 8"/><path d="M21 18c6-4 12-4 17-1l6-3 2 3-6 5c-7 2-13 1-20-1Z"/><path d="M25 25v18M25 35c-5-5-9-5-12-2 3 5 7 6 12 5"/></>}
							{item.icon === "star" && <path d="m24 5 5.8 12 13.2 1.9-9.5 9.2L35.7 41 24 34.7 12.3 41l2.2-12.9L5 18.9 18.2 17Z"/>}
							{item.icon === "eye" && <><path d="M4 24s7-12 20-12 20 12 20 12-7 12-20 12S4 24 4 24Z"/><circle cx="24" cy="24" r="6"/><circle cx="24" cy="24" r="2"/></>}
							{item.icon === "couch" && <><path d="M8 27v-7a5 5 0 0 1 10 0v4h12v-4a5 5 0 0 1 10 0v7M7 26h34v13H7ZM12 39v4M36 39v4"/></>}
						</svg><div><h3>{item.label}</h3><p set:html={renderInline(item.text)} /></div></article>) : [])}</div> : <ContentBody blocks={body} ordered={isAnalysis} />}
					{isAuthor && <ol class="work-author-timeline" aria-label={`${work.author} timeline`}>{work.authorTimeline.map((item: any) => <li class={String(item.year) === String(work.year) ? "is-work-year" : ""}><strong>{item.year}</strong><span set:html={renderInline(item.text)} /></li>)}</ol>}
					{isConventions && <div class="work-conventions">
						<section class="work-conventions__group"><h3>Genre conventions</h3><ul>{section.conventionItems.filter((item: any) => item.type === "genre").map((item: any) => <li>{item.label && <strong>{item.label}: </strong>}<span set:html={renderInline(item.text)} /></li>)}</ul></section>
						<section class="work-conventions__group"><h3>Drama conventions (professor's list)</h3>{section.dramaNote ? <p set:html={renderInline(section.dramaNote)} /> : <ul>{section.conventionItems.filter((item: any) => item.type === "drama").map((item: any) => <li>{item.label && <strong>{item.label}: </strong>}<span set:html={renderInline(item.text)} /></li>)}</ul>}</section>
					</div>}
				</div>
			</section>;
		})}
		{sourceSection && <section id="references" class="work-section work-section--sources" data-work-section aria-labelledby="references-title">
			<h2 id="references-title">{sourceSection.heading}</h2>
			{conclusion && <p class="work-conclusion" set:html={renderInline(conclusion)} />}
			<details class="work-sources">
				<summary>Show sources</summary>
				<ul>{sourceList.map((item: any) => <li><span set:html={renderInline(item.text)} />{item.url && <> <a href={item.url} target="_blank" rel="noopener">{item.url}</a></>}</li>)}</ul>
			</details>
		</section>}
	</article>
	{nextWork && <NextWork title={nextWork.title} link={nextWork.href} theme={nextTheme} />}
</div>

<script>
	const root = document.documentElement;
	const reduced = () => root.classList.contains("reduce-motion-active") || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	document.querySelectorAll<HTMLButtonElement>(".work-text-paper__toggle").forEach((button) => {
		button.addEventListener("click", () => {
			const expanded = button.getAttribute("aria-expanded") !== "true";
			button.setAttribute("aria-expanded", String(expanded));
			const continuation = document.getElementById(button.getAttribute("aria-controls") || "");
			if (continuation) continuation.hidden = !expanded;
			button.textContent = expanded ? "Hide full text" : button.dataset.story === "true" ? "Read the full story" : "Show the full poem";
		});
	});
	document.querySelectorAll<HTMLDetailsElement>(".work-sources").forEach((details) => {
		const summary = details.querySelector<HTMLElement>("summary");
		const sync = () => {
			summary?.setAttribute("aria-expanded", String(details.open));
			if (summary) summary.textContent = details.open ? "Hide sources" : "Show sources";
		};
		sync();
		details.addEventListener("toggle", sync);
	});
	const workSections = Array.from(document.querySelectorAll<HTMLElement>(".work-section"));
	if (workSections.length && !reduced() && "IntersectionObserver" in window) {
		root.classList.add("work-reveals-ready");
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.1 });
		workSections.forEach((section) => observer.observe(section));
	}
</script>
