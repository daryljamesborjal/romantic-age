---
// Daffodils reading and study page.
import PoemLayout from "../layouts/PoemLayout.astro";
import DaffodilsScene from "../components/scene/DaffodilsScene.astro";
import ContentSection from "../components/content/ContentSection.astro";
import NextWork from "../components/shared/NextWork.astro";
import ContentBody from "../components/content/ContentBody.astro";
import work from "../data/works/daffodils.js";

const inlineHtml = (value: string = "") => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('\"', "&quot;").replaceAll("'", "&#39;").replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/\*([^*]+)\*/g, "<em>$1</em>");
const stanzaHtml = (lines: string[]) => lines.map(inlineHtml).join("<br />") + "<br />";

---

<PoemLayout title={`${work.title} | Romantic Age`} themeClass="poem-page daffodils-theme">
	<!-- Vector landscape decoration stays inside the viewport-height hero. -->
	<section class="daffodils-hero" aria-labelledby="page-title">
		<DaffodilsScene />
		<div class="daffodils-hero__content">
			<p class="daffodils-hero__eyebrow">{work.label}</p>
			<h1 id="page-title">{work.title}</h1>
			<p class="daffodils-hero__author">{work.year} · {work.tagline}</p>
		</div>
	</section>

	<!-- Stanza paragraphs with explicit line breaks preserve the poem's form. -->
	<details class="reading-panel">
		<summary>{work.textTitle}</summary>
		<div class="text-content">
			<div class="text-content__inner">
				<div class="poem-stanzas" aria-label={`${work.title} by ${work.author}`}>
					{work.text.map((stanza) => <p set:html={stanzaHtml(stanza)} />)}
				</div>
			</div>
		</div>
	</details>

	<article class="daffodils-content" aria-label={`${work.title} study sections`}>
		{work.sections.map((section, index) => (
			<ContentSection id={section.id} title={section.heading} summary={section.preview} align={index % 2 === 0 ? "left" : "right"}>
				<ContentBody blocks={section.body} />
			</ContentSection>
		))}
	</article>
	<NextWork title="Annabel Lee" link="/annabel-lee" theme="daffodils" />
</PoemLayout>

<style>
	.poem-stanzas {
		max-width: 70ch;
		margin-inline: auto;
		text-align: center;
	}

	.poem-stanzas p + p {
		margin-top: 1.75rem;
	}
</style>
