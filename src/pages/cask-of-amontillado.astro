---
// Cask page skeleton: headings and placeholders are ready for a later content phase.
import PoemLayout from "../layouts/PoemLayout.astro";
---

<PoemLayout title="The Cask of Amontillado | Romantic Age" themeClass="poem-page cask-theme">
	<!-- The arch and candlelit gradient are decorative CSS, with no JavaScript. -->
	<section class="cask-hero" aria-labelledby="page-title">
		<div class="cask-hero__decoration" aria-hidden="true"></div>
		<div class="cask-hero__content">
			<p class="cask-hero__eyebrow">A story by Edgar Allan Poe</p>
			<h1 id="page-title">The Cask of Amontillado</h1>
			<p class="cask-hero__author">Edgar Allan Poe</p>
		</div>
	</section>

	<details class="reading-panel">
		<summary>Read the Full Text</summary>
		<div class="text-content">
			<div class="text-content__inner">
				<p>The full text of The Cask of Amontillado will be placed here. Please add the text through the Codex prompt.</p>
			</div>
		</div>
	</details>

	<article class="cask-content" aria-label="The Cask of Amontillado study sections">
		<section class="cask-section" aria-labelledby="author-heading">
			<h2 id="author-heading">Author</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="context-heading">
			<h2 id="context-heading">Time, Era, and Societal Context</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="summary-heading">
			<h2 id="summary-heading">Summary (Characters, Setting, Plot)</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="analysis-heading">
			<h2 id="analysis-heading">Analysis (Salient Points)</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="themes-heading">
			<h2 id="themes-heading">Major Themes and Motifs</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="symbols-heading">
			<h2 id="symbols-heading">Major Symbols</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="conventions-heading">
			<h2 id="conventions-heading">Important Conventions</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="resonance-heading">
			<h2 id="resonance-heading">How the Text Resonates Today</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="cask-section" aria-labelledby="references-heading">
			<h2 id="references-heading">References and Conclusion</h2>
			<p>Content coming soon...</p>
		</section>
	</article>
</PoemLayout>
