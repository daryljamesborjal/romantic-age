---
// Cask of Amontillado reading and study page.
import PoemLayout from "../layouts/PoemLayout.astro";
import CaskScene from "../components/scene/CaskScene.astro";
import work from "../data/works/cask-of-amontillado.js";
import WorkLayout from "../layouts/WorkLayout.astro";


---

<PoemLayout title={`${work.title} | Romantic Age`} themeClass="poem-page cask-theme">
	<!-- The arch and candlelit gradient are decorative CSS, with no JavaScript. -->
	<section class="cask-hero" aria-labelledby="page-title">
		<CaskScene />
		<div class="cask-hero__decoration" aria-hidden="true"></div>
		<div class="hero-bottom-fade" aria-hidden="true"></div>
		<div class="cask-hero__content">
			<p class="cask-hero__eyebrow">{work.label}</p>
			<h1 id="page-title">{work.title}</h1>
			<p class="cask-hero__author">{work.year} · {work.tagline}</p>
		</div>
	</section>

	<WorkLayout work={work} />
</PoemLayout>
