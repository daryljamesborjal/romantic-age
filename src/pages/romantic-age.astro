---
import BaseLayout from "../layouts/BaseLayout.astro";
import { romanticAge } from "../data/romantic-age.js";
import SectionChips from "../components/shared/SectionChips.astro";

const initialsFor = (name: string) => {
	const words = name.split(/\s+/).filter(Boolean);
	return `${words[0]?.[0] || ""}${words.at(-1)?.[0] || ""}`.toUpperCase();
};
const escapeHtml = (text: string) => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;");
const renderInline = (text: string) => escapeHtml(text)
	.replace(/\*([^*]+)\*/g, "<em>$1</em>")
	.replace(/https?:\/\/[^\s<]+/g, (url) => `<a href="${url}" target="_blank" rel="noopener">${url}</a>`);
const firstTimelineEntry = romanticAge.timeline[0];
const ageChips = [
	{ label: "Overview", id: "overview" },
	{ label: "Timeline", id: "timeline" },
	{ label: "Ideas", id: "ideas" },
	{ label: "Britain & America", id: "britain-america" },
	{ label: "Voices", id: "voices" },
	{ label: "Why it matters", id: "why-it-matters" },
	{ label: "Sources", id: "sources" },
];
---

<BaseLayout title="What Was the Romantic Age? | Romantic Age" mainClass="romantic-age-shell" description={romanticAge.subtitle}>
	<article class="romantic-age-page" aria-labelledby="page-title">
		<header class="romantic-age-hero">
				<svg class="age-storm-scene" viewBox="0 0 1200 470" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
					<defs>
						<linearGradient id="age-day-sky" x2="0" y2="1"><stop stop-color="#8295a8"/><stop offset=".55" stop-color="#c4cbd0"/><stop offset="1" stop-color="#e3d7c4"/></linearGradient>
						<linearGradient id="age-night-sky" x2="0" y2="1"><stop stop-color="#101b31"/><stop offset=".65" stop-color="#283650"/><stop offset="1" stop-color="#414c5a"/></linearGradient>
						<radialGradient id="age-sun-glow" cx="45%" cy="45%" r="55%"><stop stop-color="#fff4cb" stop-opacity=".62"/><stop offset=".48" stop-color="#fff0c2" stop-opacity=".24"/><stop offset="1" stop-color="#fff0c2" stop-opacity="0"/></radialGradient>
						<radialGradient id="age-moon-glow" cx="44%" cy="42%" r="58%"><stop stop-color="#e6eef5" stop-opacity=".34"/><stop offset=".48" stop-color="#dce7ef" stop-opacity=".14"/><stop offset="1" stop-color="#dce7ef" stop-opacity="0"/></radialGradient>
						<radialGradient id="age-lightning-glow" cx="55%" cy="55%" r="65%"><stop stop-color="#fff8db" stop-opacity=".42"/><stop offset="1" stop-color="#dce7f0" stop-opacity="0"/></radialGradient>
					</defs>
					<g class="age-storm-scene__day">
						<rect width="1200" height="470" fill="url(#age-day-sky)"/>
						<circle cx="875" cy="116" r="142" fill="url(#age-sun-glow)"/>
						<circle cx="875" cy="116" r="78" fill="#f5e8bf" opacity=".82"/>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--one"><path d="M80 130c15-44 72-54 105-21 18-60 107-64 132-4 53-16 101 22 93 70H80c-17-13-14-32 0-45Z" fill="#e5e8e8" opacity=".88"/></g>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--two"><path d="M520 88c13-34 58-41 82-15 14-43 76-48 94-4 39-12 74 15 68 50H520c-13-9-11-23 0-31Z" fill="#778a9a" opacity=".72"/></g>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--three"><path d="M980 200c14-38 62-46 87-17 16-49 84-53 104-4 43-13 81 18 75 57H980c-14-10-12-27 0-36Z" fill="#d8dddf" opacity=".72"/></g>
						<path d="M0 325 92 270l88 34 90-107 104 76 120-119 82 88 110-132 106 94 106-65 105 93 98-67 99 73v232H0Z" fill="#697c8b"/>
						<path d="m0 360 112-62 84 29 114-84 103 78 103-65 108 67 94-82 119 80 99-55 112 55 152-70v219H0Z" fill="#425c66"/>
						<path d="m0 393 99-44 103 40 122-57 98 53 117-43 125 46 103-51 118 49 109-34 102 34 104-33v117H0Z" fill="#334c4d"/>
					</g>
					<g class="age-storm-scene__night">
						<rect width="1200" height="470" fill="url(#age-night-sky)"/>
						<circle cx="875" cy="116" r="132" fill="url(#age-moon-glow)"/>
						<circle cx="875" cy="116" r="55" fill="#d9dfdf" opacity=".88"/>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--one"><path d="M80 130c15-44 72-54 105-21 18-60 107-64 132-4 53-16 101 22 93 70H80c-17-13-14-32 0-45Z" fill="#27374b"/><path d="M80 130c15-44 72-54 105-21 18-60 107-64 132-4 53-16 101 22 93 70" fill="none" stroke="#8190a0" stroke-width="5" opacity=".4"/></g>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--two"><path d="M520 88c13-34 58-41 82-15 14-43 76-48 94-4 39-12 74 15 68 50H520c-13-9-11-23 0-31Z" fill="#1c2a40"/><path d="M520 88c13-34 58-41 82-15 14-43 76-48 94-4 39-12 74 15 68 50" fill="none" stroke="#a4b1bb" stroke-width="4" opacity=".33"/></g>
						<g class="age-storm-scene__cloud age-storm-scene__cloud--three"><path d="M980 200c14-38 62-46 87-17 16-49 84-53 104-4 43-13 81 18 75 57H980c-14-10-12-27 0-36Z" fill="#26354a"/><path d="M980 200c14-38 62-46 87-17 16-49 84-53 104-4 43-13 81 18 75 57" fill="none" stroke="#a4b1bb" stroke-width="4" opacity=".3"/></g>
						<path d="M0 325 92 270l88 34 90-107 104 76 120-119 82 88 110-132 106 94 106-65 105 93 98-67 99 73v232H0Z" fill="#34475f"/>
						<path d="m0 360 112-62 84 29 114-84 103 78 103-65 108 67 94-82 119 80 99-55 112 55 152-70v219H0Z" fill="#202e45"/>
						<path d="m0 393 99-44 103 40 122-57 98 53 117-43 125 46 103-51 118 49 109-34 102 34 104-33v117H0Z" fill="#121d2d"/>
					</g>
					<rect class="age-storm-scene__lightning" x="420" y="210" width="700" height="250" fill="url(#age-lightning-glow)"/>
				</svg>
				<div class="romantic-age-hero__copy">
					<p class="romantic-age-kicker">A Literary Era</p>
					<h1 id="page-title">What Was the Romantic Age?</h1>
					<p class="romantic-age-subtitle">{romanticAge.subtitle}</p>
					<p class="romantic-age-read-time">{romanticAge.readTime}</p>
				</div>
		</header>

		<SectionChips items={ageChips} />

		<div class="romantic-age-content">

			<section id="at-a-glance" class="age-glance" aria-label="At a glance">
				{romanticAge.atAGlance.map((fact) => <div class="age-glance__fact"><h2>{fact.label}</h2><p set:html={renderInline(fact.value)} /></div>)}
			</section>

			<section id="overview" class="romantic-age-section" data-age-section aria-labelledby="overview-title">
				<h2 id="overview-title">Overview</h2>
				<div class="age-prose">{romanticAge.overview.map((paragraph) => <p set:html={renderInline(paragraph)} />)}</div>
			</section>

			<section id="timeline" class="romantic-age-section" data-age-section aria-labelledby="timeline-title">
				<h2 id="timeline-title">Timeline</h2>
				<ol class="age-timeline">
					{romanticAge.timeline.map((event, index) => (
						<li class="age-timeline__item">
							<button class="age-timeline__trigger" type="button" aria-expanded={index === 0 ? "true" : "false"} aria-controls={`age-timeline-detail age-timeline-inline-${index}`}>
								<span class="age-timeline__year">{event.year}</span><span class="age-timeline__title" set:html={renderInline(event.title)} />
							</button>
							<p class="age-timeline__detail-source" hidden set:html={renderInline(event.text)} />
							<div class="age-timeline__inline-detail" id={`age-timeline-inline-${index}`} hidden={index !== 0} aria-live="polite"><p set:html={renderInline(event.text)} /></div>
						</li>
					))}
				</ol>
				<div class="age-timeline__detail" id="age-timeline-detail" aria-live="polite"><p set:html={renderInline(firstTimelineEntry.text)} /></div>
			</section>

			<section id="ideas" class="romantic-age-section" data-age-section aria-labelledby="ideas-title">
				<h2 id="ideas-title">Core ideas</h2>
				<div class="age-ideas">
					{romanticAge.coreIdeas.map((idea, index) => (
						<article class="age-idea">
							<button class="age-idea__trigger" type="button" aria-expanded="false" aria-controls={`age-idea-detail-${index}`}>
								<svg class="age-idea__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
									{idea.icon === "heart" && <path d="M24 40S6 29 6 17a9 9 0 0 1 17-4 9 9 0 0 1 17 4c0 12-16 23-16 23Z"/>}
									{idea.icon === "feather" && <><path d="M39 8C20 7 11 18 12 34c8-10 15-17 27-23ZM9 39c8-12 16-19 30-31M15 31l-1-8m8 2-1-9m3 16 9-1"/><path d="M8 40h11"/></>}
									{idea.icon === "leaf" && <><path d="M40 7C20 7 8 15 8 29c0 7 5 11 11 11 14 0 21-13 21-33Z"/><path d="M8 41c8-10 16-17 29-30M18 31l-1-8m9 1-1-8"/></>}
									{idea.icon === "person" && <><circle cx="24" cy="14" r="7"/><path d="M10 42v-5a14 14 0 0 1 28 0v5M24 22v13m-7-8 7 5 7-5"/></>}
									{idea.icon === "mountain" && <><path d="m4 39 13-25 8 14 7-11 12 22H4Z"/><path d="m17 14 5 10 4-5m6-2-4 8 5 2"/></>}
									{idea.icon === "arch" && <><path d="M8 42V21a16 16 0 0 1 32 0v21M15 42V22a9 9 0 0 1 18 0v20M4 42h40M24 5l-3 7h6l-3 6"/></>}
								</svg>
									<span class="age-idea__term" set:html={renderInline(idea.term)} />
									<span class="age-idea__summary" set:html={renderInline(idea.summary)} />
									<span class="age-idea__plus" aria-hidden="true">+</span>
							</button>
							<div class="age-idea__detail" id={`age-idea-detail-${index}`} hidden><p set:html={renderInline(idea.text)} /></div>
						</article>
					))}
				</div>
			</section>

			<section id="britain-america" class="romantic-age-section" data-age-section aria-labelledby="comparison-title">
				<h2 id="comparison-title">British and American Romanticism</h2>
				<div class="age-comparison-tabs" role="tablist" aria-label="Romanticism by region">
					<button id="age-tab-britain" type="button" role="tab" aria-selected="true" aria-controls="age-panel-britain" tabindex="0">Britain</button>
					<button id="age-tab-america" type="button" role="tab" aria-selected="false" aria-controls="age-panel-america" tabindex="-1">America</button>
				</div>
				<div class="age-comparison">
					<section id="age-panel-britain" class="age-comparison__panel" role="tabpanel" aria-labelledby="age-tab-britain" tabindex="0">
						<h3>British Romanticism</h3>{romanticAge.britishVsAmerican.british.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
					</section>
					<section id="age-panel-america" class="age-comparison__panel" role="tabpanel" aria-labelledby="age-tab-america" tabindex="0" hidden>
						<h3>American Romanticism</h3>{romanticAge.britishVsAmerican.american.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
					</section>
				</div>
				<p class="age-shared"><strong>Shared ground</strong> <span set:html={renderInline(romanticAge.britishVsAmerican.shared)} /></p>
			</section>

			<section id="voices" class="romantic-age-section" data-age-section aria-labelledby="voices-title">
				<h2 id="voices-title">Key voices</h2>
				<ul class="age-voices">
					{romanticAge.keyVoices.map((voice) => (
						<li class="age-voice">
							<span class="age-voice__monogram" aria-hidden="true">{voice.initials || initialsFor(voice.name)}</span>
							<div><h3>{voice.name}</h3><p class="age-voice__meta">{voice.years} · {voice.country}</p><p set:html={renderInline(voice.text)} /></div>
						</li>
					))}
				</ul>
			</section>

			<section id="why-it-matters" class="romantic-age-section" data-age-section aria-labelledby="why-title">
				<h2 id="why-title">Why it still matters</h2>
				<div class="age-prose">{romanticAge.whyItMatters.map((paragraph) => <p set:html={renderInline(paragraph)} />)}</div>
			</section>

			<section id="sources" class="romantic-age-section age-sources" data-age-section aria-labelledby="sources-title">
				<h2 id="sources-title">Sources</h2>
				<details>
					<summary>Show sources</summary>
					<ul>{romanticAge.references.map((reference) => <li set:html={renderInline(reference)} />)}</ul>
				</details>
			</section>
		</div>
	</article>
</BaseLayout>

<script>
	const root = document.documentElement;
	const reduceMotion = () => root.classList.contains("reduce-motion-active") || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const pageSections = Array.from(document.querySelectorAll<HTMLElement>("[data-age-section]"));
	if ("IntersectionObserver" in window) {
		const revealObserver = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add("is-visible");
				revealObserver.unobserve(entry.target);
			});
		}, { threshold: 0.1 });
		if (!reduceMotion()) {
			root.classList.add("age-reveals-ready");
			pageSections.forEach((section) => {
				section.classList.add("age-reveal");
				revealObserver.observe(section);
			});
		}
	} else {
		pageSections.forEach((section) => section.classList.add("is-visible"));
	}

	const isPhone = window.matchMedia("(max-width: 767px)");
	const timelineItems = Array.from(document.querySelectorAll<HTMLElement>(".age-timeline__item"));
	const timelineDetail = document.querySelector<HTMLElement>("#age-timeline-detail p");
	const timelinePanel = document.querySelector<HTMLElement>("#age-timeline-detail");
	function syncTimelineLayout() {
		const selectedIndex = timelineItems.findIndex((item) => item.querySelector(".age-timeline__trigger")?.getAttribute("aria-expanded") === "true");
		if (timelinePanel) timelinePanel.hidden = isPhone.matches;
		timelineItems.forEach((item, index) => {
			const inlinePanel = item.querySelector<HTMLElement>(".age-timeline__inline-detail");
			if (inlinePanel) inlinePanel.hidden = !isPhone.matches || index !== selectedIndex;
		});
	}
	syncTimelineLayout();
	isPhone.addEventListener("change", syncTimelineLayout);
	timelineItems.forEach((item) => {
		const button = item.querySelector<HTMLButtonElement>(".age-timeline__trigger");
		button?.addEventListener("click", () => {
			const wasExpanded = button.getAttribute("aria-expanded") === "true";
			if (isPhone.matches) {
				timelineItems.forEach((other) => {
					const otherButton = other.querySelector<HTMLButtonElement>(".age-timeline__trigger");
					const selected = other === item && !wasExpanded;
					otherButton?.setAttribute("aria-expanded", String(selected));
					const inlinePanel = other.querySelector<HTMLElement>(".age-timeline__inline-detail");
					if (inlinePanel) inlinePanel.hidden = !selected;
				});
				return;
			}
			if (wasExpanded) return;
			const source = item.querySelector<HTMLElement>(".age-timeline__detail-source");
			if (timelineDetail && source) timelineDetail.innerHTML = source.innerHTML;
			timelineItems.forEach((other) => {
				const otherButton = other.querySelector<HTMLButtonElement>(".age-timeline__trigger");
				const selected = other === item;
				otherButton?.setAttribute("aria-expanded", String(selected));
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>(".age-idea__trigger").forEach((button) => {
		button.addEventListener("click", () => {
			const expanded = button.getAttribute("aria-expanded") !== "true";
			button.setAttribute("aria-expanded", String(expanded));
			const panel = document.getElementById(button.getAttribute("aria-controls") || "");
			if (panel) panel.hidden = !expanded;
		});
	});

	const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".age-comparison-tabs [role=tab]"));
	const tabList = document.querySelector<HTMLElement>(".age-comparison-tabs");
	function selectRegionTab(selected: HTMLButtonElement, moveFocus = false) {
		if (tabList) {
			if (isPhone.matches) {
				tabList.hidden = false;
				tabList.setAttribute("role", "tablist");
			} else {
				tabList.hidden = true;
				tabList.removeAttribute("role");
			}
		}
		tabButtons.forEach((tab) => {
			const active = tab === selected;
			tab.setAttribute("aria-selected", String(active));
			tab.tabIndex = active ? 0 : -1;
			const panel = document.getElementById(tab.getAttribute("aria-controls") || "");
			if (panel) {
				panel.hidden = isPhone.matches && !active;
				if (isPhone.matches) {
					panel.setAttribute("role", "tabpanel");
					panel.setAttribute("aria-labelledby", tab.id);
					panel.setAttribute("tabindex", "0");
				} else {
					panel.setAttribute("role", "region");
					panel.removeAttribute("aria-labelledby");
					panel.removeAttribute("tabindex");
				}
			}
		});
		if (moveFocus) selected.focus();
	}
	if (tabButtons.length) {
		selectRegionTab(tabButtons[0]);
		tabButtons.forEach((tab, index) => {
			tab.addEventListener("click", () => selectRegionTab(tab));
			tab.addEventListener("keydown", (event) => {
				if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
				event.preventDefault();
				const step = event.key === "ArrowRight" ? 1 : -1;
				selectRegionTab(tabButtons[(index + step + tabButtons.length) % tabButtons.length], true);
			});
		});
		isPhone.addEventListener("change", () => selectRegionTab(tabButtons.find((tab) => tab.getAttribute("aria-selected") === "true") || tabButtons[0]));
	}

	document.querySelectorAll<HTMLDetailsElement>(".age-sources details").forEach((details) => {
		const summary = details.querySelector<HTMLElement>("summary");
		const sync = () => {
			summary?.setAttribute("aria-expanded", String(details.open));
			if (summary) summary.textContent = details.open ? "Hide sources" : "Show sources";
		};
		sync();
		details.addEventListener("toggle", sync);
	});
</script>

<style>
	:global(main.site-main.romantic-age-shell) {
		--age-paper: #f4efdf; --age-ink: #29261f; --age-muted: #494439; --age-gold: #765b2c; --age-rule: rgb(118 91 44 / 32%);
		width: 100%; max-width: none; min-height: calc(100vh - 5rem); min-height: calc(100svh - 5rem); margin: 0; padding: 0;
		background: var(--age-paper); color: var(--age-ink);
	}
	:global(html[data-theme="dark"] main.site-main.romantic-age-shell) { --age-paper:#11141b; --age-ink:#f4eddf; --age-muted:#ded5c3; --age-gold:#d9b76c; --age-rule:rgb(217 183 108 / 34%); }
	.romantic-age-page { width: 100%; margin: 0; padding: 0 0 clamp(4rem, 8vw, 7rem); }
	.romantic-age-content { transform-origin: top center; animation: age-scroll-unroll 700ms cubic-bezier(.2,.7,.25,1) both; }
	.romantic-age-content { width: min(calc(100% - 4rem), 65rem); margin-inline: auto; }
	@keyframes age-scroll-unroll { from { transform: scaleY(.96); opacity: 0; } to { transform: scaleY(1); opacity: 1; } }
	.section-chips a:focus-visible,.age-comparison-tabs button:focus-visible { outline: 3px solid var(--age-gold); outline-offset: 2px; }
	.romantic-age-hero { position: relative; width: 100%; min-height: clamp(23rem, 48vw, 33rem); display: grid; overflow: hidden; place-items: center; isolation: isolate; margin: 0; background: #8295a8; text-align: center; }
	.age-storm-scene { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
	.age-storm-scene__night { display: none; }
	:global(html[data-theme="dark"]) .age-storm-scene__day { display: none; }
	:global(html[data-theme="dark"]) .age-storm-scene__night { display: block; }
	.romantic-age-hero::before { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, transparent 5%, rgb(240 235 220 / 24%) 38%, rgb(240 235 220 / 36%) 68%, transparent 100%); content: ""; }
	:global(html[data-theme="dark"]) .romantic-age-hero::before { background: linear-gradient(180deg, transparent 5%, rgb(8 13 23 / 20%) 36%, rgb(8 13 23 / 38%) 72%, transparent 100%); }
	.romantic-age-hero__copy { width: min(100% - 2rem, 52rem); padding: 3rem 0; color: #1d2b3b; text-shadow: 0 1px 1px rgb(255 255 255 / 70%); }
	:global(html[data-theme="dark"]) .romantic-age-hero__copy { color: #fff5df; text-shadow: 0 2px 12px rgb(0 0 0 / 55%); }
	.romantic-age-kicker { margin: 0 0 .65rem; color: var(--age-gold); font: 700 .78rem/1.4 system-ui,sans-serif; letter-spacing: .17em; text-transform: uppercase; }
	.romantic-age-hero h1 { max-width: 17ch; margin: 0 auto; font-size: clamp(2.35rem, 6vw, 4.25rem); font-weight: 500; line-height: 1.08; text-wrap: balance; }
	.romantic-age-subtitle { max-width: 54ch; margin: 1rem auto 0; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.6; }
	.romantic-age-read-time { margin: .65rem 0 0; font: 600 .82rem/1.4 system-ui,sans-serif; letter-spacing: .04em; }
	.age-storm-scene__cloud { transform-box: fill-box; transform-origin: center; animation: storm-cloud-drift 70s ease-in-out infinite alternate; }
	.age-storm-scene__cloud--two { animation-duration: 96s; animation-delay: -39s; }
	.age-storm-scene__cloud--three { animation-duration: 82s; animation-delay: -22s; }
	@keyframes storm-cloud-drift { to { transform: translateX(38px); } }
	.age-storm-scene__lightning { opacity: 0; animation: storm-lightning 10s ease-in-out infinite; }
	@keyframes storm-lightning { 0%, 72%, 100% { opacity: 0; } 79% { opacity: .16; } 85% { opacity: .22; } 94% { opacity: .06; } }
	.age-glance { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 0; border-block: 1px solid var(--age-rule); }
	.age-glance__fact { padding: 1.1rem clamp(.75rem,2vw,1.5rem); border-right: 1px solid var(--age-rule); }
	.age-glance__fact:last-child { border-right: 0; }
	.age-glance__fact h2 { margin: 0 0 .35rem; color: var(--age-gold); font: 700 .78rem/1.3 system-ui,sans-serif; letter-spacing: .08em; text-transform: uppercase; }
	.age-glance__fact p { margin: 0; color: var(--age-ink); font-family: Georgia, "Times New Roman", serif; font-size: 1rem; line-height: 1.5; }
