---
// Annabel Lee page structure; literary content remains placeholder text for now.
import PoemLayout from "../layouts/PoemLayout.astro";
---

<PoemLayout title="Annabel Lee | Romantic Age" themeClass="poem-page annabel-lee-theme">
	<!-- The decorative moon and wave layers are CSS-only and hidden from assistive technology. -->
	<section class="annabel-hero" aria-labelledby="page-title">
		<div class="annabel-hero__decoration" aria-hidden="true"></div>
		<div class="annabel-hero__content">
			<p class="annabel-hero__eyebrow">A poem by Edgar Allan Poe</p>
			<h1 id="page-title">Annabel Lee</h1>
			<p class="annabel-hero__author">Edgar Allan Poe</p>
		</div>
	</section>

	<article class="annabel-content" aria-label="Annabel Lee study sections">
		<section class="annabel-section" aria-labelledby="author-heading">
			<h2 id="author-heading">Author</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="annabel-section" aria-labelledby="context-heading">
			<h2 id="context-heading">Time, Era, and Societal Context</h2>
			<p>Content coming soon...</p>
		</section>

		<section class="annabel-section" aria-labelledby="summary-heading">
