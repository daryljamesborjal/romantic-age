---
// Landing page: select a book to open its corresponding work page.
import BaseLayout from "../layouts/BaseLayout.astro";
import Room from "../components/landing/Room.astro";
import Book3D from "../components/landing/Book3D.astro";
import { landing } from "../data/landing.js";
import { works } from "../data/works.js";
---

<BaseLayout title="Romantic Age - Home" mainClass="landing-page">
	<Room backgroundImage={landing.backgroundImage}>
		<section class="landing-content" aria-labelledby="page-title">
			<div class="landing-copy">
				<p class="landing-kicker">A collection of literary works</p>
				<h1 id="page-title">Choose a Text to Explore</h1>
				<p class="landing-welcome">Three works of the Romantic Age. Pick a book to open it.</p>
			</div>

			<ul
				id="book-carousel"
				class:list={["book-list", works.length > 4 && "book-list--scrollable"]}
				tabindex="0"
				aria-label="Choose a work. Scroll horizontally to browse."
			>
				{works.map((work, index) => (
					<li class="book-list__item" id={`book-slide-${work.id}`}>
						<Book3D
							work={work}
							delay={index * 0.55}
							forward={index === Math.floor(works.length / 2) ? 16 : 0}
						/>
					</li>
				))}
			</ul>
			{works.length > 1 && (
				<div class="book-pagination" role="group" aria-label="Choose a book">
					{works.map((work, index) => (
						<button
							class="book-pagination__dot"
							type="button"
							data-slide-index={index}
							aria-label={`Show ${work.title}`}
							aria-current={index === 0 ? "true" : undefined}
						></button>
					))}
				</div>
			)}
		</section>
	</Room>
</BaseLayout>

<script>
	const landingBookLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".book-link"));
	const arrivalStorageKey = "romantic-age-book-arrival";
	type OpeningSequence = {
		layer: HTMLDivElement;
		clone: HTMLAnchorElement;
		original: HTMLAnchorElement;
		destination: string;
		themeColor: string;
		cleanup?: () => void;
	};
	let activeSequence: OpeningSequence | null = null;

	function wait(milliseconds: number) {
		return new Promise<void>((resolve) => window.setTimeout(resolve, milliseconds));
	}

	function isReducedMotionEnabled() {
		return window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion-active");
	}

	function saveArrivalColor(color: string) {
		try { sessionStorage.setItem(arrivalStorageKey, color); } catch { /* Navigation remains available when storage is blocked. */ }
	}

	function navigateToWork(sequence: OpeningSequence) {
		if (activeSequence !== sequence) return;
		activeSequence = null;
		sequence.cleanup?.();
		sequence.original.style.visibility = "";
		sequence.layer.remove();
		saveArrivalColor(sequence.themeColor);
		window.location.assign(sequence.destination);
	}

	function createOpeningLayer(original: HTMLAnchorElement, bounds: DOMRect, destination: string, themeColor: string) {
		const layer = document.createElement("div");
		layer.className = "book-opening-layer";
		layer.setAttribute("aria-hidden", "true");
		const backdrop = document.createElement("div");
		backdrop.className = "book-opening-backdrop";
		const colorWash = document.createElement("div");
		colorWash.className = "book-opening-color-wash";
		colorWash.style.backgroundColor = themeColor;
		const clone = original.cloneNode(true) as HTMLAnchorElement;
		clone.classList.add("book-link--opening-clone");
		clone.setAttribute("tabindex", "-1");
		clone.style.position = "absolute";
		clone.style.left = `${bounds.left}px`;
		clone.style.top = `${bounds.top}px`;
		clone.style.width = `${bounds.width}px`;
		clone.style.height = `${bounds.height}px`;
		clone.style.margin = "0";
		clone.style.transform = "none";
		clone.style.transformOrigin = "center center";
		const sourceStage = original.querySelector<HTMLElement>(".book3d-stage");
		const cloneStage = clone.querySelector<HTMLElement>(".book3d-stage");
		if (sourceStage && cloneStage) cloneStage.style.height = getComputedStyle(sourceStage).height;
		const sourceBook = original.querySelector<HTMLElement>(".book3d");
		const cloneBook = clone.querySelector<HTMLElement>(".book3d");
		if (sourceBook && cloneBook) cloneBook.style.transform = getComputedStyle(sourceBook).transform;
		layer.append(backdrop, colorWash, clone);
		document.body.append(layer);
		return { layer, clone, colorWash, cloneBook };
	}

	const bookCarousel = document.querySelector<HTMLUListElement>("#book-carousel");
	const bookSlides = Array.from(bookCarousel?.querySelectorAll<HTMLElement>(".book-list__item") ?? []);
	const bookDots = Array.from(document.querySelectorAll<HTMLButtonElement>(".book-pagination__dot"));
	const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

	if (bookCarousel && bookSlides.length > 0 && bookDots.length > 0) {
		let scrollFrame = 0;

		const updateActiveDot = () => {
			scrollFrame = 0;
			const carouselCenter = bookCarousel.getBoundingClientRect().left + bookCarousel.clientWidth / 2;
			let activeIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;

			bookSlides.forEach((slide, index) => {
				const bounds = slide.getBoundingClientRect();
				const distance = Math.abs(bounds.left + bounds.width / 2 - carouselCenter);
				if (distance < closestDistance) {
					closestDistance = distance;
					activeIndex = index;
				}
			});

			bookDots.forEach((dot, index) => {
				if (index === activeIndex) dot.setAttribute("aria-current", "true");
				else dot.removeAttribute("aria-current");
			});
		};

		const queueDotUpdate = () => {
			if (scrollFrame) return;
			scrollFrame = window.requestAnimationFrame(updateActiveDot);
		};

		bookCarousel.addEventListener("scroll", queueDotUpdate, { passive: true });
		window.addEventListener("resize", queueDotUpdate, { passive: true });
		bookDots.forEach((dot, index) => {
				dot.addEventListener("click", () => {
					bookSlides[index]?.scrollIntoView({ behavior: "auto", block: "nearest", inline: "center" });
				});
		});
		updateActiveDot();
	}

	// Update the cover sheen once per animation frame on hover-capable devices only.
	if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
		document.querySelectorAll<HTMLAnchorElement>(".book-link").forEach((book) => {
			let pointerX = 0;
			let pointerY = 0;
			let pointerFrame = 0;

			book.addEventListener("pointermove", (event) => {
				pointerX = event.clientX;
				pointerY = event.clientY;
				if (
					pointerFrame ||
					motionPreference.matches ||
					document.documentElement.classList.contains("reduce-motion-active")
				) return;

				pointerFrame = window.requestAnimationFrame(() => {
					pointerFrame = 0;
					if (
						motionPreference.matches ||
						document.documentElement.classList.contains("reduce-motion-active")
					) return;
					const bounds = book.getBoundingClientRect();
					book.style.setProperty("--mx", `${((pointerX - bounds.left) / bounds.width) * 100}%`);
					book.style.setProperty("--my", `${((pointerY - bounds.top) / bounds.height) * 100}%`);
				});
			}, { passive: true });
		});
	}

	landingBookLinks.forEach((bookLink) => {
		bookLink.addEventListener("click", async (event: MouseEvent) => {
			const isPlainActivation = event.button === 0 && !event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey;
			if (activeSequence) {
				event.preventDefault();
				navigateToWork(activeSequence);
				return;
			}
			if (!isPlainActivation) return;

			event.preventDefault();
			const destination = bookLink.href;
			const themeColor = bookLink.dataset.themeColor ?? "#111624";
			if (isReducedMotionEnabled()) {
				saveArrivalColor(themeColor);
				window.location.assign(destination);
				return;
			}

			const bounds = bookLink.getBoundingClientRect();
			const opening = createOpeningLayer(bookLink, bounds, destination, themeColor);
			const sequence: OpeningSequence = { layer: opening.layer, clone: opening.clone, original: bookLink, destination, themeColor };
			activeSequence = sequence;
			bookLink.style.visibility = "hidden";

			const bookFace = opening.clone.querySelector<HTMLElement>(".book3d");
			const faceWidth = bookFace?.offsetWidth ?? bounds.width * 0.68;
			const faceHeight = bookFace?.offsetHeight ?? bounds.height;
			const fitScale = Math.min((window.innerWidth * 0.9) / (faceWidth * 2), (window.innerHeight * 0.7) / faceHeight);
			const flightX = window.innerWidth / 2 - (bounds.left + bounds.width / 2);
			const flightY = window.innerHeight / 2 - (bounds.top + bounds.height / 2);

			opening.layer.addEventListener("pointerdown", () => navigateToWork(sequence));
			opening.layer.addEventListener("click", (nextClick) => {
				nextClick.preventDefault();
				navigateToWork(sequence);
			});
			opening.clone.addEventListener("click", (cloneClick) => {
				cloneClick.preventDefault();
				navigateToWork(sequence);
			});
			const escapeToNavigate = (keyEvent: KeyboardEvent) => {
				if (keyEvent.key !== "Escape") return;
				keyEvent.preventDefault();
				navigateToWork(sequence);
			};
			document.addEventListener("keydown", escapeToNavigate);
			sequence.cleanup = () => document.removeEventListener("keydown", escapeToNavigate);
			opening.layer.classList.add("book-opening-layer--visible");
			void opening.clone.offsetWidth;
			requestAnimationFrame(() => {
				if (opening.cloneBook) opening.cloneBook.style.transform = "";
				opening.clone.style.transform = `translate3d(${flightX}px, ${flightY}px, 0) scale(${fitScale})`;
			});
			await wait(350);
			if (activeSequence !== sequence) return;
			opening.clone.classList.add("is-cover-open");
			await wait(550);
			if (activeSequence !== sequence) return;
			opening.clone.classList.add("is-fluttering");
			await wait(850);
			if (activeSequence !== sequence) return;
			opening.clone.classList.add("is-entering");
			opening.colorWash.classList.add("book-opening-color-wash--visible");
			await wait(400);
			if (activeSequence !== sequence) return;
			navigateToWork(sequence);
		});
	});
</script>

<style>
	:global(main.site-main.landing-page) {
		width: 100%;
		min-width: 0;
		max-width: 100%;
		margin: 0;
		padding: 0;
		min-height: 0;
	}

	:global(main.site-main.landing-page .reading-room),
	:global(main.site-main.landing-page .reading-room__content) {
		width: 100%;
		min-width: 0;
		max-width: 100%;
	}

	.landing-content {
		--book-h: clamp(300px, 46vh, 480px);
		width: 100%;
		min-width: 0;
		max-width: 100%;
		margin: auto;
		text-align: center;
	}

	.landing-copy {
		--landing-copy-scrim-strong: 86%;
		--landing-copy-scrim-mid: 84%;
		position: relative;
		z-index: 0;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		isolation: isolate;
		padding: 0.75rem 1rem;
	}

	.landing-copy::before {
		position: absolute;
		z-index: -1;
		top: -0.25rem;
		bottom: -0.75rem;
		left: 0;
		right: 0;
		background: linear-gradient(
			to bottom,
			transparent 0%,
			rgb(10 6 4 / var(--landing-copy-scrim-strong)) 12%,
			rgb(10 6 4 / var(--landing-copy-scrim-strong)) 82%,
			rgb(10 6 4 / var(--landing-copy-scrim-mid)) 90%,
			rgb(10 6 4 / 40%) 95%,
			transparent 100%
		);
		content: "";
		pointer-events: none;
	}

	:global(html[data-theme="light"]) .landing-copy {
		--landing-copy-scrim-strong: 65%;
		--landing-copy-scrim-mid: 63%;
	}

	:global(html[data-theme="dark"]) .landing-copy::before {
		bottom: -12rem;
		background: linear-gradient(
			to bottom,
			transparent 0%,
			rgb(10 6 4 / 86%) 12%,
			rgb(10 6 4 / 86%) 60%,
			rgb(10 6 4 / 78%) 70%,
			rgb(10 6 4 / 60%) 80%,
			rgb(10 6 4 / 40%) 88%,
			rgb(10 6 4 / 18%) 96%,
			transparent 100%
		);
	}

	.landing-kicker {
		margin: 0 0 0.75rem;
		color: #fff8e9;
		font-family: system-ui, sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-shadow: 0 1px 0.2rem rgb(0 0 0 / 95%), 0 0 1rem rgb(0 0 0 / 85%);
	}

	.landing-content h1 {
		margin: 0;
		color: #fff8e9;
		font-size: clamp(2rem, 5vw, 3.7rem);
		font-weight: 500;
		text-shadow: 0 2px 0.3rem rgb(0 0 0 / 95%), 0 0 1.4rem rgb(0 0 0 / 90%);
	}

	.landing-welcome {
		max-width: 45ch;
		margin: 0.5rem auto 0;
		color: #fff8e9;
		font-size: clamp(0.95rem, 1.6vw, 1.1rem);
		text-shadow: 0 1px 0.2rem rgb(0 0 0 / 95%), 0 0 1rem rgb(0 0 0 / 85%);
		text-wrap: balance;
	}

	.book-list {
		--bob: 6px;
		--lift: 10px;
		--ribbon: 48px;
		--shadow: 24px;
		--float-pad: calc(var(--bob) + var(--lift) + var(--ribbon) + var(--shadow) + 8px);
		--book-list-gap: clamp(1rem, 3vh, 2rem);
		display: flex;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 3vw, 3rem);
		margin-block: calc(var(--book-list-gap) - var(--float-pad)) calc(0px - var(--float-pad) + var(--ribbon) + 8px);
		margin-inline: 0;
		padding-block: var(--float-pad);
		padding-inline: 0;
		overflow-x: auto;
		overflow-y: hidden;
		list-style: none;
	}

	.book-list__item {
		flex: 0 1 clamp(204px, 31.28vh, 326px);
		min-width: 0;
		scroll-snap-align: center;
	}

	.book-list--scrollable {
		justify-content: flex-start;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
	}

	.book-list--scrollable .book-list__item {
		flex: 0 0 clamp(204px, 31.28vh, 326px);
	}

	.book-pagination {
		display: none;
	}

	.book-pagination__dot {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
	}

	.book-pagination__dot::before {
		width: 0.5rem;
		height: 0.5rem;
		transform: scale(1);
		border-radius: 999px;
		background: rgb(255 248 233 / 70%);
		content: "";
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.book-pagination__dot[aria-current="true"]::before {
		transform: scaleX(1.55);
		background: #fff0ca;
	}

	.book-pagination__dot:focus-visible {
		outline: 2px solid #fff19a;
		outline-offset: 1px;
	}

	@media (max-width: 48rem) {
		.landing-copy {
			padding: 0.25rem 0.75rem;
		}

		.landing-kicker {
			margin-bottom: 0.4rem;
		}

		.landing-content h1 {
			line-height: 1.15;
		}

		.landing-welcome {
			line-height: 1.4;
		}

		.book-list {
			justify-content: flex-start;
			gap: 0.75rem;
			--book-list-gap: 0.5rem;
			margin-inline: 0;
			padding-inline: 52px;
			scroll-padding-inline: 52px;
			scroll-snap-type: x mandatory;
			overscroll-behavior-x: contain;
			scrollbar-width: none;
		}

		.book-list::-webkit-scrollbar {
			display: none;
		}

		.book-list__item,
		.book-list--scrollable .book-list__item {
			flex: 0 0 auto;
			width: 100%;
			scroll-snap-align: center;
		}

		.book-pagination {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.15rem;
			margin-top: -0.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book-pagination__dot::before {
			transition: none;
		}
	}

	:global(html.reduce-motion-active) .book-pagination__dot::before {
		transition: none;
	}

</style>
