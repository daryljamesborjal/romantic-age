---
// Project overview and group credits for the About page.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About This Project | Romantic Age">
	<div class="about-page">
		<section aria-labelledby="page-title">
			<h1 id="page-title">About This Project</h1>
			<p class="about-description">
				A digital collection of literary works exploring the Romantic Age. This site was built as a final project for our Great Books course at Bicol University to make classic literature engaging and interactive.
			</p>
		</section>

		<section class="group-section" aria-labelledby="group-title">
			<h2 id="group-title">The Romantics</h2>
			<ul class="member-list">
				<li>Barrameda, Ane Christel T.</li>
				<li>Bonaobra, Ian Raphael N.</li>
				<li>Borjal, Daryl James M.</li>
				<li>Jasareno, France Mhary</li>
				<li>Pancho, Rhona Mae R.</li>
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.about-page {
		width: min(100%, 52rem);
		margin-inline: auto;
	}

	.about-page h1 {
		margin-top: 0;
		color: var(--text-color);
	}

	.about-description {
		max-width: 65ch;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		line-height: 1.8;
	}

	.group-section {
		margin-top: clamp(2.5rem, 7vw, 4rem);
		padding: clamp(1.25rem, 4vw, 2rem);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		background: var(--card-bg);
	}

	.group-section h2 {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: clamp(1.5rem, 4vw, 2rem);
	}

	.member-list {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding-left: 1.25rem;
		color: var(--text-color);
	}
</style>
