---
// A quiet title page for the project and its contributors.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About This Project | Romantic Age" mainClass="about-page-shell">
	<div class="about-page">
		<header class="about-intro">
			<p class="about-kicker">A Great Books Final Project</p>
			<h1 id="page-title">About This Project</h1>
			<p class="about-description">
				A digital collection of literary works exploring the Romantic Age. This site was built as a final project for our Great Books course at Bicol University to make classic literature engaging and interactive.
			</p>
		</header>

		<svg class="about-divider" viewBox="0 0 240 20" aria-hidden="true" focusable="false">
			<path d="M0 10h104m32 0h104" />
			<path class="about-divider__diamond" d="m120 3 7 7-7 7-7-7z" />
		</svg>

		<section class="group-section" aria-labelledby="group-title">
			<h2 id="group-title">The Romantics</h2>
			<ul class="member-list">
				<li>Barrameda, Ane Christel T.</li>
				<li>Bonaobra, Ian Raphael N.</li>
				<li>Borjal, Daryl James M.</li>
				<li>Jasareno, France Mhary</li>
				<li>Pancho, Rhona Mae R.</li>
			</ul>
			<p class="about-meta">Great Books · BSIT 4C · Bicol University · 2026</p>
		</section>

		<svg class="about-divider" viewBox="0 0 240 20" aria-hidden="true" focusable="false">
			<path d="M0 10h104m32 0h104" />
			<path class="about-divider__diamond" d="m120 3 7 7-7 7-7-7z" />
		</svg>

		<section class="image-credits-section" aria-labelledby="image-credits-title">
			<h2 id="image-credits-title">Image and sound credits</h2>
			<p>[PLACEHOLDER: credits to be added]</p>
		</section>
	</div>
</BaseLayout>

<style>
	:global(.site-main.about-page-shell) {
		--about-paper: #f4efdf;
		--about-ink: #29261f;
		--about-muted: #494439;
		--about-gold: #765b2c;
		width: 100%;
		max-width: none;
		min-height: calc(100vh - 5rem);
		min-height: calc(100svh - 5rem);
		margin: 0;
		padding: 0;
		background: var(--about-paper);
		color: var(--about-ink);
	}

	:global(html[data-theme="dark"] .site-main.about-page-shell) {
		--about-paper: #11141b;
		--about-ink: #f4eddf;
		--about-muted: #ded5c3;
		--about-gold: #d9b76c;
	}

	.about-page {
		display: flex;
		width: min(100% - 3rem, 46rem);
		min-height: inherit;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(4.5rem, 9vw, 7rem);
		text-align: center;
	}

	.about-page > * {
		animation: about-enter 700ms cubic-bezier(.2,.7,.25,1) both;
	}

	.about-page > :nth-child(1) { animation-delay: 80ms; }
	.about-page > :nth-child(2) { animation-delay: 190ms; }
	.about-page > :nth-child(3) { animation-delay: 300ms; }
	.about-page > :nth-child(4) { animation-delay: 410ms; }
	.about-page > :nth-child(5) { animation-delay: 520ms; }

	@keyframes about-enter {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.about-intro { width: 100%; }

	.about-kicker {
		margin: 0 0 0.9rem;
		color: var(--about-muted);
		font-family: system-ui, sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.17em;
		text-transform: uppercase;
	}

	.about-page h1 {
		margin: 0;
		color: var(--about-ink);
		font-size: clamp(2.25rem, 6vw, 4rem);
		font-weight: 500;
		line-height: 1.12;
	}

	.about-description {
		max-width: 60ch;
		margin: 1.35rem auto 0;
		color: var(--about-muted);
		font-size: clamp(1.05rem, 1.7vw, 1.16rem);
		line-height: 1.85;
	}

	.about-divider {
		width: min(15rem, 62%);
		height: 1.25rem;
		margin-block: clamp(2rem, 4vw, 3rem);
		overflow: visible;
		fill: var(--about-gold);
		stroke: var(--about-gold);
		stroke-width: 1;
	}

	.about-divider__diamond { stroke-width: 0; }

	.group-section { width: 100%; }

	.group-section h2 {
		margin: 0 0 1.15rem;
		color: var(--about-gold);
		font-size: clamp(2.3rem, 5.5vw, 3.6rem);
		font-weight: 400;
		line-height: 1.15;
	}

	.member-list {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
		color: var(--about-ink);
		font-size: clamp(1.05rem, 2vw, 1.18rem);
		list-style: none;
	}

	.about-meta {
		margin: 1.35rem 0 0;
		color: var(--about-muted);
		font-size: 0.9rem;
		letter-spacing: 0.035em;
	}

	.image-credits-section {
		width: 100%;
		text-align: left;
	}

	.image-credits-section h2 {
		margin: 0 0 0.55rem;
		color: var(--about-gold);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.image-credits-section p {
		margin: 0;
		color: var(--about-muted);
		font-size: 0.92rem;
		line-height: 1.7;
	}

	@media (max-width: 767px) {
		.about-page {
			width: calc(100% - 2.5rem);
			padding-block: 3.25rem;
		}

		.about-description { margin-top: 1.1rem; }
		.about-divider { margin-block: 1.8rem; }
		.member-list { gap: 0.5rem; }
		.about-meta { max-width: 30ch; margin-inline: auto; line-height: 1.65; }
	}

	@media (prefers-reduced-motion: reduce) {
		.about-page > * { animation: none; opacity: 1; transform: none; }
	}

	:global(html.reduce-motion-active) .about-page > * {
		animation: none;
		opacity: 1;
		transform: none;
	}
</style>
